---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import AppStoreButton from '../../components/AppStoreButton.astro';
import { ARCHIVE, FEATURED, MINI_COUNT, PUZZLE_COUNT, THEME_PAGE } from '../../data/archive';
import { SITE } from '../../consts';

const title = 'Bible Crossword Puzzles by Theme — Bible Crossword Challenge';
const description =
  `Browse ${PUZZLE_COUNT} hand-crafted Bible crossword puzzles by theme, from Noah’s Ark to the Book of Revelation. Clues rooted in the King James Version. Free on iOS.`;

const featured = FEATURED;
const archive = ARCHIVE;

// A theme page that nothing links to is a page Google will not find. This hub
// is the only place that lists every puzzle, so any landing page missing from
// THEME_PAGE is stranded — fail the build rather than ship it silently.
const linked = new Set(Object.values(THEME_PAGE));
const stranded = (await getCollection('puzzles'))
  .map((entry) => `/puzzles/${entry.id}/`)
  .filter((href) => !linked.has(href));
if (stranded.length) {
  throw new Error(
    `Puzzle pages not reachable from /puzzles/: ${stranded.join(', ')}\n` +
      'Add each to THEME_PAGE in src/data/archive.ts, keyed by its archive title.'
  );
}

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Puzzles', item: `${SITE}/puzzles/` },
  ],
};

// The whole archive as one ordered list, so a search or answer engine can read
// "which Bible crosswords exist" without parsing the page's visual grouping.
// Puzzles covered by a theme landing page carry its URL; the rest are named
// entries, which is still enough for the title and its verse to be quotable.
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Bible crossword puzzles by theme',
  description: `${PUZZLE_COUNT} hand-crafted Bible crossword puzzles, grouped by difficulty. Every puzzle ends on the King James Version verse behind its theme.`,
  numberOfItems: PUZZLE_COUNT,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: archive.flatMap((group) =>
    group.items.map(([name, ref], i) => {
      const href = THEME_PAGE[name];
      const url = href ? `${SITE}${href}` : undefined;
      return {
        '@type': 'ListItem',
        position:
          archive.slice(0, archive.indexOf(group)).reduce((n, g) => n + g.items.length, 0) + i + 1,
        item: {
          '@type': 'Game',
          name: `${name} — Bible crossword`,
          genre: 'Crossword',
          about: `${name} (${ref}, King James Version)`,
          ...(url ? { url } : {}),
          isPartOf: { '@type': 'VideoGameSeries', name: 'Bible Crossword Challenge' },
        },
      };
    })
  ),
};
---
<Layout title={title} description={description} path="/puzzles/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListLd)} />
  </Fragment>

  <main id="main" class="page">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span>/</span>Puzzles</p>
      <p class="eyebrow">The archive</p>
      <h1>Bible crossword puzzles, by theme</h1>
      <p class="meta-chips"><b>{PUZZLE_COUNT}</b> full-size puzzles · <b>{MINI_COUNT}</b> quick minis · a new daily puzzle at midnight</p>
      <div class="prose">
        <p>Every puzzle in Bible Crossword Challenge is hand-crafted around one story or theme, with clues rooted in the King James Version. Start with a theme below, or browse the whole archive — from <em>In the Beginning</em> to <em>The Book of Revelation</em>.</p>
      </div>

      <div class="content-section">
        <h2>Browse by topic</h2>
        <div class="prose">
          <p><a href="/puzzles/old-testament/">Old Testament</a> · <a href="/puzzles/new-testament/">New Testament</a> · <a href="/puzzles/christmas-and-easter/">Christmas &amp; Easter</a> · <a href="/puzzles/for-kids/">for kids</a> · <a href="/puzzles/printable/">printable PDFs</a></p>
        </div>

        <h2>Featured themes</h2>
        <div class="theme-grid">
          {featured.map((t) => (
            <a class="theme-card" href={t.href}>
              <span class="t-eyebrow" set:html={t.eyebrow} />
              <span class="t-name">{t.name}</span>
              <span class="t-sub">{t.sub}</span>
            </a>
          ))}
        </div>

        <h2>The full archive</h2>
        <div class="prose"><p>The daily puzzle is always free. Premium unlocks the complete archive — every puzzle below, plus {MINI_COUNT} mini puzzles for quick play.</p></div>
        {archive.map((group) => (
          <div class="arch-group">
            <h3>{group.tier}</h3>
            {/* A title with a landing page links to it. This hub is the only
                page that lists every puzzle, so it is how the theme pages get
                crawled — leaving them as plain text stranded them. */}
            <ul class="arch-list">
              {group.items.map(([name, ref]) => {
                const href = THEME_PAGE[name];
                return (
                  <li>
                    {href ? <a href={href}>{name}</a> : <span>{name}</span>}
                    <span class="ref">{ref}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}

        <div style="margin-top:34px"><AppStoreButton /></div>
      </div>
    </div>
  </main>
</Layout>
