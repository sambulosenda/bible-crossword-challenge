---
import Layout from '../layouts/Layout.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import { SITE, APP_STORE_URL } from '../consts';

const title = 'Bible Crossword Challenge — a daily Bible crossword for iOS';
const description =
  'A fresh Bible crossword every day. Clues rooted in Scripture, from Genesis to Revelation. Build a streak, earn achievements, and end every puzzle on a verse. Free on iOS.';

// The feature list is written as crossword entries, because that is how this
// product talks. The answers double as the tiles that fill in on scroll.
const features = {
  across: [
    { n: '2A', answer: 'DAILY', enum: '(5)', text: 'A new hand-crafted puzzle waiting every morning' },
    { n: '4A', answer: 'STREAK', enum: '(6)', text: 'Played today, and yesterday, and the day before' },
    { n: '6A', answer: 'VERSE', enum: '(5)', text: 'What every finished puzzle ends on — KJV, chapter and all' },
  ],
  down: [
    { n: '1D', answer: 'HINTS', enum: '(5)', text: 'Fair nudges that unstick you without spoiling it' },
    { n: '3D', answer: 'ARCHIVE', enum: '(7)', text: "Where 80+ puzzles live, from Noah's Ark to Easter morning" },
    { n: '5D', answer: 'OFFLINE', enum: '(7)', text: 'Works on a plane, in the pew, or anywhere else' },
  ],
};

const screens = [
  { img: 'shot-today', alt: "The Today screen: streak counter, today's puzzle, Verse of the Day, and next achievement", cap: 'Begin the day', body: "Your streak, today's puzzle, and the Verse of the Day in one quiet screen." },
  { img: 'shot-puzzle', alt: 'The crossword grid mid-solve, with the clue “Black bird that fed the prophet Elijah”', cap: 'Solve the grid', body: 'Clues like “Black bird that fed the prophet Elijah” teach as you type.' },
  { img: 'shot-profile', alt: 'The Profile screen with puzzles completed, streaks, and achievements', cap: 'Watch it grow', body: 'Puzzles completed, best streaks, and achievements earned along the way.' },
];

const faqs = [
  { q: 'Is Bible Crossword Challenge free?', a: 'Yes — download and play the daily puzzle for free. Premium unlocks the full archive and extras.' },
  { q: 'Is there a new Bible crossword puzzle every day?', a: "Yes. A fresh daily Bible crossword arrives at midnight, and the archive holds 80+ hand-crafted puzzles across the whole Bible — from Noah's Ark to Easter morning." },
  { q: 'How difficult are the puzzles?', a: 'They are made for everyone — lifelong believers and casual solvers alike. If a clue has you stuck, smart hints nudge you along without spoiling the answer.' },
  { q: 'Do I need an account?', a: 'No. The app works fully offline and your progress is saved on your device — and synced privately through iCloud if you play on more than one.' },
  { q: 'Which Bible translation do the verses use?', a: 'All verses are drawn from the King James Version (KJV).' },
  { q: 'Does it work on iPad?', a: 'Yes — Bible Crossword Challenge runs on both iPhone and iPad, and your progress syncs between them through iCloud.' },
  { q: 'Is there an Android version?', a: "Bible Crossword Challenge is on iOS today. If you'd like it on Android, tell us — it genuinely helps us decide." },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Bible Crossword Challenge',
  url: `${SITE}/`,
  installUrl: APP_STORE_URL,
  operatingSystem: 'iOS',
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Word',
  author: { '@type': 'Person', name: 'Sambulo Senda' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', url: APP_STORE_URL },
  screenshot: screens.map((s) => `${SITE}/assets/${s.img}.png`),
  description: 'A fresh Bible crossword every day. Solve scripture-themed puzzles, build a daily streak, and learn the Word as you play.',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={title} description={description} path="/" overHero>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <main id="main">
    <!-- ════ 1. HERO — ink ════════════════════════════════════════════════ -->
    <section class="band band-ink hero">
      <div class="grid-field" aria-hidden="true"></div>
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow rise">A daily Bible crossword for iPhone</p>
          {/* Spaces flank each <br> so the line still reads as a sentence on
              narrow screens, where the breaks are hidden. */}
          <h1 class="rise d1">Know the Word, <br />one square <br />at a time.</h1>
          <p class="lede rise d2">
            A fresh crossword every day, with clues rooted in Scripture — from Genesis to
            Revelation. Build a streak, earn achievements, and end every puzzle on a verse.
          </p>
          <div class="rise d3"><AppStoreButton /></div>
        </div>

        <div class="xw-wrap rise d4" aria-label="An example crossword solving the words faith, grace, daily and streak">
          <div class="xw" id="xw" aria-hidden="true"></div>
          <div class="xw-clue" id="xw-clue" aria-hidden="true">
            <span class="xw-clue-num" id="xw-clue-num">&nbsp;</span>
            <span class="xw-clue-text" id="xw-clue-text">&nbsp;</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ 2. FEATURES AS A CLUE LIST — paper ═══════════════════════════ -->
    <section class="band band-paper" id="features">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">What's inside</p>
          <h2>Everything, in so many words.</h2>
          <p class="sec-sub">The features, written the only way a crossword app should write them.</p>
        </div>

        <div class="clues">
          <div class="clue-col reveal">
            <h3>Across</h3>
            {features.across.map((c) => (
              <div class="clue" data-answer={c.answer}>
                <div class="clue-q"><span class="clue-n">{c.n}</span><span class="clue-text">{c.text} <span class="enum">{c.enum}</span></span></div>
                <div class="tiles" aria-label={`Answer: ${c.answer.toLowerCase()}`}></div>
              </div>
            ))}
          </div>
          <div class="clue-col reveal" data-delay="120">
            <h3>Down</h3>
            {features.down.map((c) => (
              <div class="clue" data-answer={c.answer}>
                <div class="clue-q"><span class="clue-n">{c.n}</span><span class="clue-text">{c.text} <span class="enum">{c.enum}</span></span></div>
                <div class="tiles" aria-label={`Answer: ${c.answer.toLowerCase()}`}></div>
              </div>
            ))}
          </div>
          <p class="clues-foot reveal">
            <strong>Also in the box:</strong> achievements from Bible Beginner to Apostle, iCloud
            sync across your devices, light &amp; dark mode, and not a single ad between you and
            the Word.
          </p>
        </div>
      </div>
    </section>

    <!-- ════ 3. VERSE — ink ═══════════════════════════════════════════════ -->
    <section class="band band-ink verse-band">
      <div class="wrap reveal">
        <span class="orn" aria-hidden="true">✦ ✦ ✦</span>
        <blockquote>“Thy word have I hid in mine heart, that I might not sin against thee.”</blockquote>
        <cite>Psalm 119 : 11 · KJV</cite>
        <p class="verse-note">
          Every puzzle closes with the verse behind its theme — so each day's play plants a little
          more Scripture in your memory.
        </p>
      </div>
    </section>

    <!-- ════ 4. SCREENS — paper ═══════════════════════════════════════════ -->
    <section class="band band-paper">
      <div class="wrap">
        <div class="reveal">
          <p class="eyebrow">A look inside</p>
          <h2>Calm, focused, and made for iOS.</h2>
          <p class="sec-sub">No clutter, no pressure — just you, a grid, and the Word.</p>
        </div>
        <div class="screens">
          {screens.map((s, i) => (
            <figure class="screen-card reveal" data-delay={i * 110}>
              <div class="device"><img src={`/assets/${s.img}.webp`} alt={s.alt} loading="lazy" width="720" height="1566" /></div>
              <figcaption class="screen-cap">
                <span class="clue-n">{i + 1}</span>
                <p><strong>{s.cap}</strong>{s.body}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ 5. WHY — ink ═════════════════════════════════════════════════ -->
    <section class="band band-ink" id="about">
      <div class="wrap why-grid">
        <div class="reveal">
          <p class="eyebrow">Why a Bible crossword</p>
          <h2>A daily habit that plants Scripture in your memory.</h2>
        </div>
        <div class="prose reveal" data-delay="120">
          <p>Bible Crossword Challenge is a Christian word game built around one simple habit: a daily Bible crossword you can finish with your morning coffee. Every clue is rooted in Scripture — the people, places, miracles, and verses of the King James Version — so each grid you solve leaves a little more of the Word with you.</p>
          <p>Beyond the daily puzzle, an <a href="/puzzles/">archive of 80+ hand-crafted Bible crosswords</a> covers the whole story: <a href="/puzzles/noahs-ark/">Noah's Ark</a>, <a href="/puzzles/david-and-goliath/">David &amp; Goliath</a>, the Exodus, the Parables, <a href="/puzzles/christmas/">the Christmas Story</a>, <a href="/puzzles/easter/">Easter and the Resurrection</a>, and many more. Puzzles work fully offline on iPhone and iPad, sync through iCloud, and every one ends on the verse behind its theme.</p>
          <p>Whether you love Scripture, love crosswords, or both, <a href={APP_STORE_URL} rel="noopener">download Bible Crossword Challenge free on the App Store</a> and start today's puzzle.</p>
        </div>
      </div>
    </section>

    <!-- ════ 6. FAQ — paper ═══════════════════════════════════════════════ -->
    <section class="band band-paper" id="faq">
      <div class="wrap faq-grid">
        <div class="reveal">
          <p class="eyebrow">Questions</p>
          <h2>Before you ask.</h2>
        </div>
        <div class="faq reveal" data-delay="120">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ 7. CLOSE — ink (runs straight into the ink footer) ═══════════ -->
    <section class="band band-ink final" id="get">
      <div class="grid-field" aria-hidden="true"></div>
      <div class="wrap reveal">
        <p class="eyebrow">Today's puzzle is waiting</p>
        <h2>Start your streak today.</h2>
        <p class="sec-sub">Free on the App Store. Tomorrow's puzzle will be there too.</p>
        <div class="final-cta"><AppStoreButton note={false} /></div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* Home-page composition. Declared global (not scoped) because the hero grid
     and the feature tiles build their elements in JS, and scoped styles would
     not reach runtime-created nodes. */

  /* The nav sits over the ink hero, so the page behind it must be ink too —
     otherwise the sticky bar renders as a paper strip above the hero. */
  html.over-hero body { background: var(--ink); }

  /* ── ambient lattice ────────────────────────────────────────────────────
     A faint crossword grid across the ink bands. Masked to a soft pool so it
     reads as texture, never as a table. */
  .grid-field {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(236, 234, 228, .05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(236, 234, 228, .05) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: radial-gradient(120% 90% at 50% 0%, #000 10%, transparent 72%);
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 10%, transparent 72%);
  }
  .band-ink > .wrap { position: relative; z-index: 1; }

  /* ── 1. hero ──────────────────────────────────────────────────────────── */
  .hero {
    min-height: calc(100svh - 72px);
    display: flex;
    align-items: center;
    padding-block: var(--s-8);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.02fr .98fr;
    gap: var(--s-8);
    align-items: center;
    width: 100%;
  }
  /* The three hard breaks are the intended setting; no measure constraint, or
     the last line reflows and orphans. Breaks are dropped again on narrow
     screens, where the headline wraps on its own. */
  .hero-copy h1 { max-width: none; }
  .hero-copy .lede { margin: 0 0 var(--s-4); }

  /* ── the signature: a grid that solves itself ─────────────────────────── */
  .xw-wrap { display: flex; flex-direction: column; align-items: center; gap: var(--s-3); }
  .xw {
    --cellsize: clamp(40px, 5.6vw, 66px);
    background: var(--bg-sunk);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: calc(var(--cellsize) * .22);
    box-shadow: var(--shadow-lift);
    display: grid;
    grid-template-columns: repeat(7, var(--cellsize));
    grid-template-rows: repeat(7, var(--cellsize));
    gap: 3px;
  }
  .xw-cell {
    background: #FFFFFF;
    color: #12151C;
    border-radius: 4px;
    position: relative;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: calc(var(--cellsize) * .5);
    transition: background .3s ease;
  }
  .xw-cell .num {
    position: absolute; top: 3px; left: 5px;
    font-family: var(--mono); font-size: calc(var(--cellsize) * .2);
    font-weight: 500; color: #6B7280;
  }
  .xw-cell.inword { background: var(--blue-wash); }
  .xw-cell .ltr { display: block; }
  .xw-cell .ltr.pop { animation: pop .3s cubic-bezier(.34, 1.56, .64, 1); }
  @keyframes pop { from { transform: scale(.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  .xw.solved .xw-cell { background: var(--green-wash); }

  .xw-clue {
    min-height: 52px; text-align: center; max-width: 34ch;
    display: flex; flex-direction: column; gap: 5px; align-items: center;
    opacity: 1; transition: opacity .25s ease;
  }
  .xw-clue.fade { opacity: 0; }
  .xw-clue-num {
    font-family: var(--mono); font-size: 11.5px; letter-spacing: .2em;
    text-transform: uppercase; color: var(--accent);
  }
  .xw-clue-text {
    font-family: var(--scripture); font-style: italic; font-size: 17px;
    line-height: 1.4; color: var(--fg-soft);
  }

  /* ── 2. feature clue list ─────────────────────────────────────────────── */
  .clues { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--s-8); margin-top: var(--s-6); }
  #features .tile { width: 30px; height: 30px; font-size: 15px; }
  #features .tile span { opacity: 0; transform: scale(.5); }
  #features .tile.on span {
    opacity: 1; transform: scale(1);
    transition: opacity .2s ease, transform .28s cubic-bezier(.34, 1.56, .64, 1);
  }
  #features .clues-foot { grid-column: 1 / -1; margin-top: var(--s-4); }

  /* ── 4. screens ───────────────────────────────────────────────────────── */
  .screens { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); margin-top: var(--s-6); align-items: start; }
  /* Stagger the middle phone so the row reads as a considered arrangement
     rather than three items in a line. */
  .screens > :nth-child(2) { transform: translateY(var(--s-6)); }
  .js .screens > :nth-child(2).reveal { transform: translateY(calc(var(--s-6) + 18px)); }
  .js .screens > :nth-child(2).reveal.in { transform: translateY(var(--s-6)); }

  .screen-card { display: flex; flex-direction: column; gap: var(--s-2); margin: 0; }
  .device {
    border-radius: 36px; border: 1px solid var(--rule); background: var(--bg-raised);
    padding: 9px; box-shadow: var(--shadow-card);
    transition: transform .22s cubic-bezier(.22, 1, .36, 1), box-shadow .22s ease;
  }
  .screen-card:hover .device { transform: translateY(-6px); box-shadow: var(--shadow-lift); }
  .device img { border-radius: 28px; width: 100%; height: auto; }
  .screen-cap { display: flex; gap: var(--s-2); align-items: baseline; padding: 0 6px; }
  .screen-cap .clue-n { min-width: auto; color: var(--gilt); }
  .screen-cap p { margin: 0; font-size: 15px; color: var(--fg-mute); }
  .screen-cap p strong {
    display: block; font-family: var(--display); font-weight: 500; font-size: 19px;
    font-variation-settings: "opsz" 30, "SOFT" 14;
    color: var(--fg); margin-bottom: 3px;
  }

  /* ── 5 & 6. two-column reading sections ───────────────────────────────── */
  .why-grid, .faq-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: var(--s-6) var(--s-8); align-items: start; }
  .why-grid h2, .faq-grid h2 { max-width: 15ch; }

  /* ── FAQ ──────────────────────────────────────────────────────────────── */
  .faq { max-width: 680px; }
  .faq details { border-bottom: 1px solid var(--rule); padding: var(--s-2) 4px; }
  .faq details:first-child { border-top: 2px solid var(--fg); }
  .faq summary {
    font-weight: 600; font-size: 17px; cursor: pointer; list-style: none;
    display: flex; justify-content: space-between; align-items: center; gap: var(--s-2);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-family: var(--mono); font-size: 20px; color: var(--gilt); flex-shrink: 0; }
  .faq details[open] summary::after { content: "–"; }
  .faq details p {
    font-family: var(--scripture); color: var(--fg-soft); font-size: 17px;
    line-height: 1.6; margin: var(--s-1) 0 0; max-width: 58ch;
  }

  /* ── 7. close ─────────────────────────────────────────────────────────── */
  .final { text-align: center; overflow: hidden; }
  .final .eyebrow { justify-content: center; }
  .final h2 { max-width: 20ch; margin-inline: auto; }
  .final .sec-sub { margin: var(--s-1) auto var(--s-4); }
  .final-cta { display: flex; justify-content: center; }
  .final .grid-field {
    -webkit-mask-image: radial-gradient(100% 80% at 50% 100%, #000 10%, transparent 70%);
    mask-image: radial-gradient(100% 80% at 50% 100%, #000 10%, transparent 70%);
  }

  /* ── responsive ───────────────────────────────────────────────────────── */
  @media (max-width: 980px) {
    .hero { min-height: 0; }
    .hero-grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .hero-copy { text-align: center; }
    .hero-copy h1, .hero-copy .lede { margin-inline: auto; }
    .hero-copy h1 br { display: none; }
    .hero-copy .cta-row { justify-content: center; }
    .why-grid, .faq-grid { grid-template-columns: 1fr; gap: var(--s-3); }
    .why-grid h2, .faq-grid h2 { max-width: 20ch; }
  }
  @media (max-width: 820px) {
    .clues { grid-template-columns: 1fr; gap: 0; }
    .clue-col + .clue-col h3 { margin-top: var(--s-4); }
    .screens { grid-template-columns: 1fr; max-width: 330px; margin-inline: auto; gap: var(--s-4); }
    .screens > :nth-child(2),
    .js .screens > :nth-child(2).reveal,
    .js .screens > :nth-child(2).reveal.in { transform: none; }
  }
</style>

<script>
  // ── Hero crossword: a mini grid that solves itself on a loop ─────────────
  (function () {
    const SIZE = 7;
    const WORDS = [
      { num: 1, dir: 'Down', ans: 'FAITH', clue: 'The substance of things hoped for — Hebrews 11:1', cells: [[0, 2], [1, 2], [2, 2], [3, 2], [4, 2]] },
      { num: 2, dir: 'Across', ans: 'GRACE', clue: '“By ___ are ye saved through faith” — Ephesians 2:8', cells: [[1, 0], [1, 1], [1, 2], [1, 3], [1, 4]] },
      { num: 3, dir: 'Down', ans: 'DAILY', clue: 'How often a fresh puzzle arrives', cells: [[2, 5], [3, 5], [4, 5], [5, 5], [6, 5]] },
      { num: 4, dir: 'Across', ans: 'STREAK', clue: 'What grows when you play every day', cells: [[3, 1], [3, 2], [3, 3], [3, 4], [3, 5], [3, 6]] },
    ];
    const grid = document.getElementById('xw');
    const clueNum = document.getElementById('xw-clue-num');
    const clueText = document.getElementById('xw-clue-text');
    const clueBox = document.getElementById('xw-clue');
    if (!grid || !clueNum || !clueText || !clueBox) return;

    const isCell: Record<string, boolean> = {};
    WORDS.forEach((w) => w.cells.forEach((rc) => { isCell[rc[0] + ',' + rc[1]] = true; }));
    const cellEls: Record<string, HTMLElement> = {};
    for (let r = 0; r < SIZE; r++) {
      for (let c = 0; c < SIZE; c++) {
        const key = r + ',' + c;
        if (isCell[key]) {
          const el = document.createElement('div');
          el.className = 'xw-cell';
          el.style.gridRow = String(r + 1);
          el.style.gridColumn = String(c + 1);
          cellEls[key] = el;
          grid.appendChild(el);
        }
      }
    }
    WORDS.forEach((w) => {
      const start = cellEls[w.cells[0][0] + ',' + w.cells[0][1]];
      if (!start.querySelector('.num')) {
        const n = document.createElement('span');
        n.className = 'num';
        n.textContent = String(w.num);
        start.appendChild(n);
      }
    });
    function setLetter(key: string, ltr: string, pop: boolean) {
      const el = cellEls[key];
      const old = el.querySelector('.ltr');
      if (old) old.remove();
      if (!ltr) return;
      const s = document.createElement('span');
      s.className = 'ltr' + (pop ? ' pop' : '');
      s.textContent = ltr;
      el.appendChild(s);
    }
    function clearAll() { Object.keys(cellEls).forEach((k) => setLetter(k, '', false)); grid!.classList.remove('solved'); }
    function showClue(w: (typeof WORDS)[number] | null) {
      clueNum!.textContent = w ? w.num + ' ' + w.dir : ' ';
      clueText!.textContent = w ? w.clue : ' ';
    }
    function fillAll() { WORDS.forEach((w) => w.cells.forEach((rc, i) => setLetter(rc[0] + ',' + rc[1], w.ans[i], false))); }

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) { fillAll(); grid.classList.add('solved'); showClue(WORDS[0]); return; }

    let visible = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => { visible = entries[0].isIntersecting; }, { threshold: 0.1 }).observe(grid);
    }
    const sleep = (ms: number) => new Promise((res) => setTimeout(res, ms));
    const waitVisible = () => new Promise<void>((res) => {
      (function check() { if (visible && !document.hidden) return res(); setTimeout(check, 250); })();
    });
    (async function run() {
      for (;;) {
        clearAll();
        showClue(null);
        await sleep(700);
        for (const w of WORDS) {
          await waitVisible();
          clueBox!.classList.add('fade');
          await sleep(220);
          showClue(w);
          clueBox!.classList.remove('fade');
          w.cells.forEach((rc) => cellEls[rc[0] + ',' + rc[1]].classList.add('inword'));
          await sleep(650);
          for (let j = 0; j < w.ans.length; j++) {
            setLetter(w.cells[j][0] + ',' + w.cells[j][1], w.ans[j], true);
            await sleep(170);
          }
          await sleep(750);
          w.cells.forEach((rc) => cellEls[rc[0] + ',' + rc[1]].classList.remove('inword'));
        }
        grid!.classList.add('solved');
        clueBox!.classList.add('fade');
        await sleep(220);
        clueNum!.textContent = 'Solved';
        clueText!.textContent = 'Tomorrow’s puzzle arrives at midnight.';
        clueBox!.classList.remove('fade');
        await sleep(3400);
        clueBox!.classList.add('fade');
        await sleep(300);
        clueBox!.classList.remove('fade');
      }
    })();
  })();

  // ── Feature clue tiles fill in when scrolled into view ───────────────────
  (function () {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('.clue').forEach((clue) => {
      const word = clue.getAttribute('data-answer') || '';
      const tiles = clue.querySelector('.tiles');
      if (!tiles) return;
      word.split('').forEach((ch) => {
        const t = document.createElement('span');
        t.className = 'tile';
        const inner = document.createElement('span');
        inner.textContent = ch;
        t.appendChild(inner);
        tiles.appendChild(t);
      });
      const els = tiles.querySelectorAll('.tile');
      const reveal = () => els.forEach((t, i) => setTimeout(() => t.classList.add('on'), reduceMotion ? 0 : 90 * i));
      if (reduceMotion || !('IntersectionObserver' in window)) { reveal(); return; }
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { reveal(); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(clue);
    });
  })();
</script>
