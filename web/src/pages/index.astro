</style>

<script>
  type Clue = { n: number; d: 'A' | 'D'; r: number; c: number; a: string; t: string };
  type Mini = { id: string; title: string; verse: string; reference: string; grid: string[]; clues: Clue[] };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const store = {
    get(k: string) { try { return localStorage.getItem(k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem(k, v); } catch { /* private mode */ } },
  };

  // ── 1. Today's Mini ─────────────────────────────────────────────────────
  (function () {
    const dataEl = document.getElementById('minis-data');
    const board = document.getElementById('board');
    const input = document.getElementById('play-input') as HTMLInputElement | null;
    if (!dataEl || !board || !input) return;
    const minis: Mini[] = JSON.parse(dataEl.textContent || '[]');
    if (!minis.length) return;

    // One puzzle per local calendar day, the same for everyone in a timezone.
    const now = new Date();
    const dayKey = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const dayNum = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000);
    const p = minis[((dayNum % minis.length) + minis.length) % minis.length];
    const weekday = now.toLocaleDateString('en-US', { weekday: 'long' });
    const SAVE = `bcc-mini-${dayKey}`;

    const $ = (id: string) => document.getElementById(id)!;
    $('play-kicker').textContent = `${weekday}’s Mini`;
    $('play-title').textContent = p.title;

    // Crop the 7×7 to the letters' bounding box, as the app does.
    let r0 = 99, r1 = -1, c0 = 99, c1 = -1;
    p.grid.forEach((row, r) => [...row].forEach((ch, c) => {
      if (ch !== '.') { r0 = Math.min(r0, r); r1 = Math.max(r1, r); c0 = Math.min(c0, c); c1 = Math.max(c1, c); }
    }));
    const rows = r1 - r0 + 1, cols = c1 - c0 + 1;
    board.style.setProperty('--rows', String(rows));
    board.style.setProperty('--cols', String(cols));

    const key = (r: number, c: number) => `${r},${c}`;
    const answer: Record<string, string> = {};
    const entry: Record<string, string> = {};
    const revealed = new Set<string>();
    const els: Record<string, HTMLElement> = {};
    const words = p.clues
      .map((cl) => ({ ...cl, cells: [...cl.a].map((_, i) => key(cl.r - r0 + (cl.d === 'D' ? i : 0), cl.c - c0 + (cl.d === 'A' ? i : 0))) }))
      .sort((a, b) => (a.d === b.d ? a.n - b.n : a.d === 'A' ? -1 : 1));
    words.forEach((w) => w.cells.forEach((k, i) => { answer[k] = w.a[i]; }));

    try {
      const saved = JSON.parse(store.get(SAVE) || 'null');
      if (saved && saved.id === p.id) Object.assign(entry, saved.entry || {});
    } catch { /* ignore */ }

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const k = key(r, c);
        const sq = document.createElement('div');
        sq.className = 'sq';
        if (answer[k]) {
          sq.classList.add('open');
          sq.setAttribute('role', 'gridcell');
          sq.dataset.k = k;
          sq.style.setProperty('--d', String(r + c));
          const start = words.find((w) => w.cells[0] === k);
          if (start) { const n = document.createElement('span'); n.className = 'num'; n.textContent = String(start.n); sq.appendChild(n); }
          const ch = document.createElement('span'); ch.className = 'ch'; sq.appendChild(ch);
          els[k] = sq;
        } else {
          sq.setAttribute('aria-hidden', 'true');
        }
        board.appendChild(sq);
      }
    }

    let wi = 0;
    let cur = words[0].cells[0];
    let started = false, solved = false, startAt = 0, elapsed = 0, timer = 0;

    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    const timeEl = $('play-time');
    function tick() { elapsed = Math.floor((Date.now() - startAt) / 1000); timeEl.textContent = fmt(elapsed); }
    function start() {
      if (started) return;
      started = true; startAt = Date.now() - elapsed * 1000;
      timer = window.setInterval(tick, 1000);
    }

    function wordsAt(k: string) { return words.filter((w) => w.cells.includes(k)); }
    function paint(popKey?: string) {
      const w = words[wi];
      Object.entries(els).forEach(([k, el]) => {
        el.classList.toggle('word', w.cells.includes(k));
        el.classList.toggle('cur', k === cur && !solved);
        const ch = el.querySelector('.ch')!;
        const v = entry[k] || '';
        if (ch.textContent !== v) {
          ch.textContent = v;
          ch.classList.remove('pop');
          if (v && k === popKey && !reduceMotion) { void (ch as HTMLElement).offsetWidth; ch.classList.add('pop'); }
        }
        el.classList.toggle('revealed', revealed.has(k));
        const where = wordsAt(k).map((x) => `${x.n} ${x.d === 'A' ? 'Across' : 'Down'} letter ${x.cells.indexOf(k) + 1}`).join(', ');
        el.setAttribute('aria-label', `${where}: ${v || 'empty'}`);
      });
      $('cb-num').textContent = `${w.n} ${w.d === 'A' ? 'Across' : 'Down'} · ${w.a.length} letters`;
      const t = $('cb-text'); t.textContent = w.t; t.classList.remove('note');
    }
    function save() { store.set(SAVE, JSON.stringify({ id: p.id, entry })); }

    function focusInput() {
      // preventScroll stops iOS jumping the page when the keyboard opens.
      input!.focus({ preventScroll: true });
      input!.value = ' ';
    }
    function setWord(i: number, toFirstEmpty = true) {
      wi = (i + words.length) % words.length;
      const w = words[wi];
      cur = toFirstEmpty ? (w.cells.find((k) => !entry[k]) || w.cells[0]) : w.cells[0];
      paint();
    }
    function advance() {
      const w = words[wi];
      const at = w.cells.indexOf(cur);
      // Next empty square in this word after the cursor, else wrap, else next clue.
      const after = w.cells.slice(at + 1).find((k) => !entry[k]) || w.cells.slice(0, at).find((k) => !entry[k]);
      if (after) { cur = after; return; }
      if (Object.keys(answer).every((k) => entry[k])) { cur = w.cells[Math.min(at + 1, w.cells.length - 1)]; return; }
      for (let j = 1; j <= words.length; j++) {
        const nw = words[(wi + j) % words.length];
        const empty = nw.cells.find((k) => !entry[k]);
        if (empty) { wi = (wi + j) % words.length; cur = empty; return; }
      }
    }
    function type(ch: string) {
      if (solved) return;
      start();
      entry[cur] = ch;
      revealed.delete(cur);
      els[cur].classList.remove('bad');
      const typed = cur;
      advance();
      paint(typed);
      save();
      check();
    }
    function back() {
      if (solved) return;
      const w = words[wi];
      if (entry[cur]) { delete entry[cur]; }
      else {
        const at = w.cells.indexOf(cur);
        if (at > 0) { cur = w.cells[at - 1]; delete entry[cur]; }
      }
      els[cur].classList.remove('bad');
      paint(); save();
    }
    function move(dr: number, dc: number) {
      const [r, c] = cur.split(',').map(Number);
      const want: 'A' | 'D' = dr ? 'D' : 'A';
      if (words[wi].d !== want) {
        const alt = wordsAt(cur).findIndex((w) => w.d === want);
        if (alt !== -1) { wi = words.indexOf(wordsAt(cur)[alt]); paint(); return; }
      }
      for (let s = 1; s < 8; s++) {
        const k = key(r + dr * s, c + dc * s);
        if (answer[k]) {
          cur = k;
          const ws = wordsAt(k);
          const keep = ws.find((w) => w.d === want) || ws[0];
          wi = words.indexOf(keep);
          paint(); return;
        }
      }
    }

    function check() {
      const keys = Object.keys(answer);
      if (!keys.every((k) => entry[k])) return;
      const wrong = keys.filter((k) => entry[k] !== answer[k]);
      if (wrong.length) {
        wrong.forEach((k) => els[k].classList.add('bad'));
        const t = $('cb-text');
        t.textContent = wrong.length === 1 ? 'Not quite. One square is off.' : `Not quite. ${wrong.length} squares are off.`;
        t.classList.add('note');
        if (!reduceMotion) { board!.classList.remove('shake'); void board!.offsetWidth; board!.classList.add('shake'); }
        return;
      }
      win();
    }

    function win(instant = false) {
      solved = true;
      window.clearInterval(timer);
      if (started) elapsed = Math.max(1, Math.round((Date.now() - startAt) / 1000));
      else elapsed = Number(store.get(`${SAVE}-t`) || 0);
      store.set(`${SAVE}-t`, String(elapsed));
      store.set(`${SAVE}-done`, '1');
      input!.blur();
      paint();
      board!.classList.add('solved');
      $('done-time').textContent = fmt(elapsed);
      $('done-meta').textContent = `${p.title} · Mini · ${now.toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long' })}`;
      $('done-verse').textContent = p.verse.trim().replace(/^[“"]|[”"]$/g, '');
      $('done-ref').textContent = p.reference;
      const show = () => {
        $('play-game').hidden = true;
        $('play-done').hidden = false;
        document.getElementById('play')!.dataset.state = 'done';
      };
      if (instant || reduceMotion) show(); else window.setTimeout(show, 1100);
    }

    // ── input wiring ──
    board.addEventListener('pointerdown', (e) => {
      const sq = (e.target as HTMLElement).closest<HTMLElement>('.sq.open');
      if (!sq || solved) return;
      e.preventDefault();
      const k = sq.dataset.k!;
      const ws = wordsAt(k);
      if (k === cur && ws.length > 1) {
        wi = words.indexOf(ws.find((w) => w !== words[wi]) || ws[0]);
      } else {
        cur = k;
        wi = words.indexOf(ws.find((w) => w.d === words[wi].d) || ws[0]);
      }
      paint();
      focusInput();
    });
    $('cb-prev').addEventListener('click', () => { setWord(wi - 1); focusInput(); });
    $('cb-next').addEventListener('click', () => { setWord(wi + 1); focusInput(); });
    $('cb-body').addEventListener('click', () => {
      const alt = wordsAt(cur).find((w) => w !== words[wi]);
      if (alt) { wi = words.indexOf(alt); paint(); }
      focusInput();
    });
    $('play-hint').addEventListener('click', () => {
      if (solved) return;
      start();
      entry[cur] = answer[cur];
      revealed.add(cur);
      els[cur].classList.remove('bad');
      const k = cur; advance(); paint(k); save(); check();
      focusInput();
    });

    // A hidden input carries the phone keyboard. It holds a single space so a
    // backspace on an "empty" field still produces an input event to read.
    input.addEventListener('input', () => {
      const v = input.value;
      if (v.length < 1) back();
      // One event can carry several letters (fast typing, paste, dictation).
      else for (const letter of v.replace(/[^a-z]/gi, '').toUpperCase()) type(letter);
      input.value = ' ';
    });
    const onKey = (e: KeyboardEvent) => {
      if (solved || e.metaKey || e.ctrlKey || e.altKey) return;
      const inPlay = document.activeElement === input || (document.activeElement === document.body && playInView);
      if (!inPlay) return;
      if (e.key === 'Backspace') { e.preventDefault(); if (document.activeElement !== input) back(); else if (input.value === ' ' || input.value === '') { back(); input.value = ' '; } }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); move(0, -1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); move(0, 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1, 0); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); move(1, 0); }
      else if (e.key === 'Tab' || e.key === 'Enter') { e.preventDefault(); setWord(wi + (e.shiftKey ? -1 : 1)); }
      else if (/^[a-z]$/i.test(e.key) && document.activeElement !== input) { e.preventDefault(); type(e.key.toUpperCase()); }
    };
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Backspace') { e.preventDefault(); back(); input.value = ' '; return; }
      if (/^[a-z]$/i.test(e.key) && !e.metaKey && !e.ctrlKey) { e.preventDefault(); type(e.key.toUpperCase()); input.value = ' '; return; }
      onKey(e);
    });
    // Desktop: start typing as soon as the grid is on screen, no click needed.
    let playInView = true;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { playInView = es[0].isIntersecting; }, { threshold: 0.5 }).observe(board);
    }
    document.addEventListener('keydown', (e) => { if (document.activeElement !== input) onKey(e); });
    document.addEventListener('visibilitychange', () => {
      if (!started || solved) return;
      if (document.hidden) window.clearInterval(timer);
      else { startAt = Date.now() - elapsed * 1000; timer = window.setInterval(tick, 1000); }
    });

    $('done-back').addEventListener('click', () => {
      $('play-done').hidden = true;
      $('play-game').hidden = false;
      document.getElementById('play')!.dataset.state = 'playing';
    });
    $('done-share').addEventListener('click', async () => {
      const text = `I solved today’s Bible Crossword mini, “${p.title}”, in ${fmt(elapsed)}. Can you beat it?`;
      const url = 'https://biblecrosswordchallenge.com/';
      const btn = $('done-share');
      try {
        if (navigator.share) { await navigator.share({ text, url }); return; }
        await navigator.clipboard.writeText(`${text} ${url}`);
        btn.textContent = 'Copied';
        window.setTimeout(() => { btn.textContent = 'Share my time'; }, 1800);
      } catch { /* dismissed */ }
    });

    paint();
    if (store.get(`${SAVE}-done`) === '1') {
      Object.keys(answer).forEach((k) => { entry[k] = answer[k]; });
      elapsed = Number(store.get(`${SAVE}-t`) || 0);
      timeEl.textContent = fmt(elapsed);
      win(true);
    }
  })();

  // ── 2. Story: the sticky phone follows the step in view ─────────────────
  (function () {
    const steps = [...document.querySelectorAll<HTMLElement>('.step')];
    const imgs = [...document.querySelectorAll<HTMLElement>('.stage-img')];
    const dots = [...document.querySelectorAll<HTMLElement>('.dot')];
    if (!steps.length || !('IntersectionObserver' in window)) { steps.forEach((s) => s.classList.add('on')); return; }
    const set = (i: number) => {
      steps.forEach((s, j) => s.classList.toggle('on', j === i));
      imgs.forEach((m, j) => m.classList.toggle('on', j === i));
      dots.forEach((d, j) => d.classList.toggle('on', j === i));
    };
    set(0);
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) set(Number((e.target as HTMLElement).dataset.i)); });
    }, { rootMargin: '-45% 0px -45% 0px' });
    steps.forEach((s) => io.observe(s));
  })();

  // ── 3. Verse: words light up as the band crosses the viewport ───────────
  (function () {
    const band = document.getElementById('verse');
    const words = [...document.querySelectorAll<HTMLElement>('#verse-q .w')];
    if (!band || !words.length) return;
    if (reduceMotion) { words.forEach((w) => w.classList.add('lit')); return; }
    let raf = 0, active = false;
    const update = () => {
      raf = 0;
      const r = band.getBoundingClientRect();
      const vh = window.innerHeight;
      // 0 when the band's top reaches 85% down the screen, 1 by the time its
      // middle passes 45%: the verse finishes while it is still centred.
      const p = Math.min(1, Math.max(0, (vh * .85 - r.top) / (r.height * .5 + vh * .4)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    };
    const onScroll = () => { if (active && !raf) raf = requestAnimationFrame(update); };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { active = es[0].isIntersecting; if (active) update(); }).observe(band);
    } else { words.forEach((w) => w.classList.add('lit')); }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  })();

  // ── 4. Feature clue tiles fill in when scrolled into view ───────────────
  (function () {
    document.querySelectorAll<HTMLElement>('.clue').forEach((clue) => {
      const word = clue.getAttribute('data-answer') || '';
      const tiles = clue.querySelector('.tiles');
      if (!tiles) return;
      word.split('').forEach((ch) => {
        const t = document.createElement('span');
        t.className = 'tile';
        const inner = document.createElement('span');
        inner.textContent = ch;
        t.appendChild(inner);
        tiles.appendChild(t);
      });
      const els = tiles.querySelectorAll('.tile');
      const reveal = () => els.forEach((t, i) => setTimeout(() => t.classList.add('on'), reduceMotion ? 0 : 90 * i));
      if (reduceMotion || !('IntersectionObserver' in window)) { reveal(); return; }
      const io = new IntersectionObserver((entries) => {
        if (entries[0].isIntersecting) { reveal(); io.disconnect(); }
      }, { threshold: 0.4 });
      io.observe(clue);
    });
  })();
</script>
