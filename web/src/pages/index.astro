<script>
  // ── Hero: type the answer into the squares ───────────────────────────────
  (function () {
    const card = document.getElementById('play');
    const input = document.getElementById('play-input') as HTMLInputElement | null;
    const reveal = document.getElementById('play-reveal');
    const status = document.getElementById('play-status');
    const solved = document.getElementById('play-solved');
    if (!card || !input || !reveal || !status || !solved) return;

    const answer = (card.dataset.answer || '').toUpperCase();
    const tiles = Array.from(card.querySelectorAll<HTMLElement>('.play-tile'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let last = '';

    function render() {
      const v = input!.value;
      tiles.forEach((t, i) => {
        const ch = v[i] || '';
        if (t.textContent !== ch) {
          t.textContent = ch;
          if (ch && !reduceMotion && i === v.length - 1 && v.length > last.length) {
            t.classList.remove('pop');
            void t.offsetWidth;
            t.classList.add('pop');
          }
        }
        t.classList.toggle('is-filled', !!ch);
        t.classList.toggle('is-cursor', i === Math.min(v.length, answer.length - 1) && v.length < answer.length);
      });
      last = v;
    }

    function check() {
      const v = input!.value;
      card!.classList.remove('is-wrong');
      if (v.length < answer.length) { status!.textContent = ''; return; }
      if (v === answer) {
        card!.classList.add('is-solved');
        input!.readOnly = true;
        status!.textContent = '';
        solved!.hidden = false;
        input!.blur();
        return;
      }
      status!.textContent = 'Not quite. Try again, or reveal a letter.';
      if (!reduceMotion) { void card!.offsetWidth; card!.classList.add('is-wrong'); }
    }

    input.addEventListener('input', () => {
      input.value = input.value.toUpperCase().replace(/[^A-Z]/g, '').slice(0, answer.length);
      render();
      check();
    });

    reveal.addEventListener('click', () => {
      // Keep the correct prefix, then give the next letter.
      let k = 0;
      while (k < answer.length && input.value[k] === answer[k]) k++;
      input.value = answer.slice(0, Math.min(answer.length, k + 1));
      render();
      check();
      if (!card.classList.contains('is-solved')) input.focus();
    });

    render();
  })();
</script>
