---
import Layout from '../layouts/Layout.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import AppRating from '../components/AppRating.astro';
import { getAppRating } from '../lib/app-store';
import { SITE, APP_STORE_URL, APP_STORE_ID } from '../consts';
import { PUZZLE_COUNT } from '../data/archive';
// Real grids from the app bundle — regenerate with scripts/export-home-grids.mjs.
import grids from '../data/home-grids.json';

// Read once at build time; null when Apple is unreachable or has no ratings yet.
const rating = await getAppRating(APP_STORE_ID);

const title = 'Bible Crossword Challenge — a daily Bible crossword for iOS';
const description =
  'A fresh Bible crossword every day. Clues rooted in Scripture, from Genesis to Revelation. Build a streak, earn achievements, and end every puzzle on a verse. Free on iOS.';

// ── Hero: one real clue from the app, playable on the page ────────────────
const hero = grids.hero;
const heroDir = hero.direction === 'across' ? 'Across' : 'Down';

// ── Sunday Special showcase: the real 21×21 grid, one entry filled in ─────
const sunday = grids.sunday;
const shown = sunday.shown;
const sundayCells = sunday.grid.flatMap((row, r) =>
  row.split('').map((ch, c) => {
    if (ch === '#') return { kind: 'block', letter: '' };
    const i = r === shown.row ? c - shown.col : -1;
    if (i >= 0 && i < shown.answer.length) return { kind: i === 0 ? 'cursor' : 'word', letter: shown.answer[i] };
    return { kind: 'open', letter: '' };
  })
);

const steps = [
  { n: '01', title: 'Read the clue', body: 'Every clue points to a person, place, miracle or verse — from Genesis to Revelation.' },
  { n: '02', title: 'Fill the grid', body: 'Type on a keyboard built for crosswords. Stuck? Check a letter, reveal a letter, or reveal the word.' },
  { n: '03', title: 'Finish on a verse', body: 'Each puzzle closes on the scripture behind it, so what you solve today stays with you tomorrow.' },
];

const daily = [
  'A new hand-crafted crossword every morning at midnight',
  'The Verse of the Day on the Today screen',
  'A two-minute Daily Mini for busy mornings',
  'Streaks and twelve achievements that reward showing up',
];

// Captions describe what is actually on each screenshot — when the app's
// screens change, refresh the images and this copy together.
const screens = [
  { img: 'shot-complete', w: 720, h: 1566, alt: 'The Puzzle Completed screen: time 51:13, a three-day streak, and the closing verse from Exodus 25:8', cap: 'Every puzzle ends on a verse' },
  { img: 'shot-puzzle', w: 720, h: 1565, alt: 'The crossword grid part-solved — JOY, GOLD and EAST filled in — with the clue “Royal title sought by the travellers”', cap: 'A grid built for thumbs' },
  { img: 'shot-achievements', w: 720, h: 1565, alt: 'The Achievements screen listing Bible Beginner, Unaided, Quick Wit, Disciple and Lightning Round, each with its goal and progress', cap: 'Achievements as you grow' },
];

const faqs = [
  { q: 'Is Bible Crossword Challenge free?', a: 'Yes — download and play the daily puzzle for free. Premium unlocks the full archive and extras, and starts with a 7-day free trial.' },
  { q: 'Is there an Android version?', a: "Bible Crossword Challenge is on iPhone and iPad today. You can play themed puzzles free in any browser on this site — and if you'd like it on Android, tell us. It genuinely helps us decide." },
  { q: 'Is there a new Bible crossword puzzle every day?', a: `Yes. A fresh daily Bible crossword arrives at midnight, and the archive holds ${PUZZLE_COUNT} hand-crafted puzzles across the whole Bible — from Noah's Ark to Easter morning.` },
  { q: 'How difficult are the puzzles?', a: 'They are made for everyone — lifelong believers and casual solvers alike. If a clue has you stuck, smart hints nudge you along without spoiling the answer.' },
  { q: 'Do I need an account?', a: 'No. The app works fully offline and your progress is saved on your device — and synced privately through iCloud if you play on more than one.' },
  { q: 'Which Bible translation do the verses use?', a: 'All verses are drawn from the King James Version (KJV).' },
  { q: 'Does it work on iPad?', a: 'Yes — Bible Crossword Challenge runs on both iPhone and iPad, and your progress syncs between them through iCloud.' },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'MobileApplication'],
  '@id': `${SITE}/#app`,
  name: 'Bible Crossword Challenge',
  alternateName: 'Bible Crossword',
  url: `${SITE}/`,
  installUrl: APP_STORE_URL,
  downloadUrl: APP_STORE_URL,
  operatingSystem: 'iOS 18.0 or later',
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Word',
  // Named explicitly because it is the single most common question an answer
  // engine is asked about an app, and "free with an optional purchase" is the
  // honest shape of it.
  isAccessibleForFree: true,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Sambulo Senda' },
  publisher: { '@id': `${SITE}/#publisher` },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    url: APP_STORE_URL,
    availability: 'https://schema.org/InStock',
    category: 'Free download with optional in-app purchase',
  },
  featureList: [
    'A new hand-crafted Bible crossword every day at midnight',
    `Archive of ${PUZZLE_COUNT} themed puzzles, from Genesis to Revelation`,
    '21×21 Sunday Specials and a two-minute 7×7 Daily Mini',
    'Every puzzle closes on the verse behind its theme',
    'Stepped hints — check a letter, reveal a letter, reveal a word',
    'Daily streaks and twelve achievements',
    'A Read tab with the whole Bible, search, reading plans and verse memorization',
    'Friend challenges: share a puzzle and compare times',
    'Works fully offline; progress syncs privately through iCloud',
    'No ads and no account required',
  ],
  screenshot: screens.map((s) => ({
    '@type': 'ImageObject',
    url: `${SITE}/assets/${s.img}.png`,
    caption: s.alt,
  })),
  // Only ever emitted alongside the rating the page itself displays — markup
  // that claims a rating the visitor cannot see is what Google calls spam.
  ...(rating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: rating.value,
          ratingCount: rating.count,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  description:
    'A fresh Bible crossword every day. Solve scripture-themed puzzles, build a daily streak, and learn the Word as you play.',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={title} description={description} path="/">
  <Fragment slot="head">
    <link rel="preload" href="/fonts/newsreader-v26-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <main id="main" class="home">
    <!-- ════ 1. HERO — copy beside one playable clue ══════════════════════ -->
    <section class="h-hero">
      <div class="h-wrap h-hero-grid">
        <div class="h-hero-copy">
          <p class="h-kicker rise">A daily Bible crossword for iPhone</p>
          <h1 class="rise d1">Know the Word, one&nbsp;square at a time.</h1>
          <p class="h-lede rise d2">
            A fresh scripture crossword every morning. Every clue is rooted in the Bible, and
            every puzzle ends on the verse behind it. Try one of today's clues right here.
          </p>
          <div class="h-hero-cta rise d3">
            <AppStoreButton />
            <a class="h-textlink" href="/puzzles/">Play a full puzzle in your browser <span aria-hidden="true">→</span></a>
          </div>
          <div class="rise d3"><AppRating rating={rating} /></div>
        </div>

        <div class="play rise d4" id="play" data-answer={hero.answer}>
          <div class="play-top">
            <span class="play-num">{hero.number} {heroDir} · {hero.answer.length} letters</span>
            <span class="play-chip">Easy</span>
          </div>
          <p class="play-clue" id="play-clue">{hero.clue}</p>

          <label class="play-label" for="play-input">Type your answer</label>
          <div class="play-field">
            <input
              class="play-input"
              id="play-input"
              type="text"
              maxlength={hero.answer.length}
              autocomplete="off"
              autocapitalize="characters"
              autocorrect="off"
              spellcheck="false"
              enterkeyhint="done"
              aria-describedby="play-clue play-status"
            />
            <div class="play-tiles" aria-hidden="true">
              {hero.answer.split('').map(() => <span class="play-tile"></span>)}
            </div>
          </div>
          <div class="play-actions">
            <button type="button" class="play-reveal" id="play-reveal">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-4 10.5c.7.7 1 1.5 1 2.5h6c0-1 .3-1.8 1-2.5A6 6 0 0 0 12 3z"/></svg>
              Reveal a letter
            </button>
            <p class="play-status" id="play-status" aria-live="polite"></p>
          </div>

          <div class="play-solved" id="play-solved" hidden>
            <span class="play-solved-k">Solved · the verse behind it</span>
            <p class="play-verse">“{hero.verse}”</p>
            <span class="play-ref">{hero.reference}</span>
            <a class="play-next" href={APP_STORE_URL} rel="noopener">Get today's full puzzle in the app</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ 2. HOW IT WORKS ══════════════════════════════════════════════ -->
    <section class="h-sec" id="how">
      <div class="h-wrap">
        <h2 class="h-h2 reveal">Five quiet minutes with Scripture, every day.</h2>
        <div class="steps">
          <article class="step reveal">
            <span class="step-n">{steps[0].n}</span>
            <div class="step-demo step-demo-clue"><span>12 Down</span>Bronze basin for washing hands and feet</div>
            <h3>{steps[0].title}</h3>
            <p>{steps[0].body}</p>
          </article>
          <article class="step reveal" data-delay="100">
            <span class="step-n">{steps[1].n}</span>
            <div class="step-demo step-demo-tiles" aria-hidden="true">
              <span class="t-word">L</span><span class="t-word">A</span><span class="t-word">V</span><span class="t-cursor"></span><span class="t-open"></span>
            </div>
            <h3>{steps[1].title}</h3>
            <p>{steps[1].body}</p>
          </article>
          <article class="step reveal" data-delay="200">
            <span class="step-n">{steps[2].n}</span>
            <div class="step-demo step-demo-verse">“And let them make me a sanctuary; that I may dwell among them.” <span>Exodus 25:8</span></div>
            <h3>{steps[2].title}</h3>
            <p>{steps[2].body}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ════ 3. SUNDAY SPECIALS — full-bleed ink ══════════════════════════ -->
    <section class="h-ink" aria-labelledby="sunday-h">
      <div class="h-wrap sunday">
        <div class="sunday-copy reveal">
          <p class="h-kicker">Sunday Specials</p>
          <h2 class="h-h2" id="sunday-h">Big grids for a slow Sunday afternoon.</h2>
          <p class="h-body">
            Full-size {sunday.size}×{sunday.size} puzzles built around a whole sweep of Scripture —
            this one, <em>{sunday.title}</em>, has {sunday.clueCount} clues. On busier days, the
            Daily Mini is a quick 7×7 you can finish in two minutes.
          </p>
          <dl class="sizes">
            <div><dt>Sunday Special</dt><dd>21×21</dd></div>
            <div><dt>Daily puzzle</dt><dd>15×15</dd></div>
            <div><dt>Daily Mini</dt><dd>7×7</dd></div>
          </dl>
        </div>
        <figure class="sunday-fig reveal" data-delay="120">
          <div class="big-grid" role="img" aria-label={`The ${sunday.size} by ${sunday.size} grid of the Sunday Special “${sunday.title}”, with ${shown.answer} filled in`}>
            {sundayCells.map((c) => <span class={`bg-${c.kind}`}>{c.letter}</span>)}
          </div>
          <figcaption><span>Across</span> {shown.clue}</figcaption>
        </figure>
      </div>
    </section>

    <!-- ════ 4. DAILY RITUAL ══════════════════════════════════════════════ -->
    <section class="h-sec">
      <div class="h-wrap ritual">
        <div class="ritual-shot reveal">
          <div class="h-device">
            <img src="/assets/shot-today.webp" alt="The Today screen: the Verse of the Day from John 10:11, today's puzzle “Wise Men from the East”, and the Daily Mini" width="720" height="1565" loading="lazy" />
          </div>
        </div>
        <div class="ritual-copy reveal" data-delay="120">
          <p class="h-kicker">Your daily ritual</p>
          <h2 class="h-h2">A verse, a puzzle, and a streak worth keeping.</h2>
          <p class="h-body">Open the app to the Verse of the Day with a new crossword waiting beneath it. Solve it, keep your streak alive, and pick up achievements along the way.</p>
          <ul class="checks">
            {daily.map((d) => (
              <li>
                <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                <span>{d}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ════ 5. NEW IN THE APP ════════════════════════════════════════════ -->
    <section class="h-sec h-sec-flush" aria-label="New in the app">
      <div class="h-wrap news">
        <article class="news-card reveal">
          <span class="news-tag">New · Read tab</span>
          <h3>The whole Bible, right beside the puzzle.</h3>
          <p>Search any passage, follow a reading plan, and memorize the verses you meet in the grid.</p>
          <div class="news-demo">
            <span class="news-demo-k">Psalm 119</span>
            <p><sup>105</sup> Thy word is a lamp unto my feet, and a light unto my path.</p>
          </div>
        </article>
        <article class="news-card reveal" data-delay="120">
          <span class="news-tag news-tag-warm">New · Friend challenges</span>
          <h3>Solve it, then dare a friend to beat your time.</h3>
          <p>Send a link from the finish screen. Your friend plays the very same grid, and you compare times side by side.</p>
          <div class="news-vs" aria-hidden="true">
            <div><span>You</span><b>4:12</b></div>
            <div class="news-vs-them"><span>Your friend</span><b>3:58</b></div>
          </div>
        </article>
      </div>
    </section>

    <!-- ════ 6. VERSE INTERLUDE ═══════════════════════════════════════════ -->
    <section class="interlude reveal" aria-label="Psalm 119:11">
      <span class="interlude-orn" aria-hidden="true"><i></i><i></i><i></i></span>
      <blockquote>“Thy word have I hid in mine heart, that I might not sin against thee.”</blockquote>
      <cite>Psalm 119:11 · KJV</cite>
    </section>

    <!-- ════ 7. THEMES — real grids as thumbnails ═════════════════════════ -->
    <section class="h-sec h-sec-white" id="themes">
      <div class="h-wrap">
        <div class="themes-head reveal">
          <div>
            <p class="h-kicker">{PUZZLE_COUNT} puzzles · Genesis to Revelation</p>
            <h2 class="h-h2">The stories you know, in so many words.</h2>
          </div>
          <a class="h-textlink" href="/puzzles/">Browse all puzzles <span aria-hidden="true">→</span></a>
        </div>
        <div class="themes">
          {grids.themes.map((t, i) => (
            <a class="theme reveal" href={t.href} data-delay={(i % 4) * 70}>
              <span class="theme-top">
                <span class="theme-tag">{t.tag}</span>
                <span class="mini" aria-hidden="true">
                  {t.grid.join('').split('').map((ch) => <i class={ch === '#' ? 'b' : ''}></i>)}
                </span>
              </span>
              <span class="theme-name">{t.name}</span>
            </a>
          ))}
          <a class="theme theme-all reveal" href="/puzzles/printable/" data-delay="210">
            <span class="theme-tag">Free to print</span>
            <span class="theme-name">Printable puzzles for Sunday school <span aria-hidden="true">→</span></span>
          </a>
        </div>
      </div>
    </section>

    <!-- ════ 8. SCREENS ═══════════════════════════════════════════════════ -->
    <section class="h-sec h-sec-sand" aria-labelledby="screens-h">
      <div class="h-wrap">
        <div class="h-center reveal">
          <h2 class="h-h2" id="screens-h">Calm, focused, and made for iPhone.</h2>
          <p class="h-body">No ads, no clutter, no pressure. Light and dark mode, offline play, and every puzzle you've solved saved in your Library.</p>
        </div>
        <div class="screens">
          {screens.map((s, i) => (
            <figure class="screen reveal" data-delay={i * 110}>
              <div class="h-device h-device-sm"><img src={`/assets/${s.img}.webp`} alt={s.alt} loading="lazy" width={s.w} height={s.h} /></div>
              <figcaption>{s.cap}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ 9. WHY — the long-form copy search engines read ══════════════ -->
    <section class="h-sec" id="about">
      <div class="h-wrap two-col">
        <h2 class="h-h2 reveal">A daily habit that plants Scripture in your memory.</h2>
        <div class="prose reveal" data-delay="120">
          <p>Bible Crossword Challenge is a Christian word game built around one simple habit: a daily Bible crossword you can finish with your morning coffee. Every clue is rooted in Scripture — the people, places, miracles, and verses of the King James Version — so each grid you solve leaves a little more of the Word with you.</p>
          <p>Beyond the daily puzzle, an <a href="/puzzles/">archive of {PUZZLE_COUNT} hand-crafted Bible crosswords</a> covers the whole story: <a href="/puzzles/noahs-ark/">Noah's Ark</a>, <a href="/puzzles/david-and-goliath/">David &amp; Goliath</a>, the Exodus, the Parables, <a href="/puzzles/christmas/">the Christmas Story</a>, <a href="/puzzles/easter/">Easter and the Resurrection</a>, and many more. Puzzles work fully offline on iPhone and iPad, sync through iCloud, and every one ends on the verse behind its theme.</p>
          <p>Whether you love Scripture, love crosswords, or both, <a href={APP_STORE_URL} rel="noopener">download Bible Crossword Challenge free on the App Store</a> and start today's puzzle.</p>
        </div>
      </div>
    </section>

    <!-- ════ 10. FAQ ══════════════════════════════════════════════════════ -->
    <section class="h-sec h-sec-flush" id="faq">
      <div class="h-wrap two-col">
        <h2 class="h-h2 reveal">Before you ask.</h2>
        <div class="faq reveal" data-delay="120">
          {faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ 11. CLOSE ════════════════════════════════════════════════════ -->
    <section class="close-wrap" id="get">
      <div class="close reveal">
        <div class="close-copy">
          <p class="h-kicker">Today's puzzle is waiting</p>
          <h2 class="h-h2">Start your streak today.</h2>
          <p class="h-body">Free on the App Store for iPhone and iPad. Tomorrow's puzzle will be there too.</p>
        </div>
        <div class="close-cta">
          <AppStoreButton note="Requires iOS 18 or later" />
          <AppRating rating={rating} />
        </div>
      </div>
    </section>
  </main>
</Layout>

<style is:global>
  /* The homepage carries the app's own look — warm paper, a serif display face,
     iOS blue — rather than the plain system pages elsewhere on the site, because
     it is the page that has to feel like the app someone is about to install.
     Everything is namespaced under .home so none of it leaks to other pages. */
  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 300 500;
    font-display: swap;
    src: url('/fonts/newsreader-v26-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Newsreader';
    font-style: normal;
    font-weight: 300 500;
    font-display: swap;
    src: url('/fonts/newsreader-v26-latin-ext.woff2') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Newsreader';
    font-style: italic;
    font-weight: 300 400;
    font-display: swap;
    src: url('/fonts/newsreader-italic-v26-latin.woff2') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  body:has(main.home) { background: #F6F5F1; }

  .home {
    --paper: #F6F5F1;
    --sand: #ECEAE3;
    --ink: #141414;
    --ink-2: #3D3D3A;
    --ink-3: #6B6A64;
    --line: #E3E1DA;
    --line-2: #D6D3CA;
    --h-blue: #0A84FF;
    --h-blue-text: #0062C4;
    --h-wash: #D6E8FF;
    --h-wash-line: #B9D6FA;
    --h-green: #DDF1E3;
    --h-green-line: #8BCB9F;
    --h-green-text: #1C6B34;
    --serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;

    /* Shared components (AppStoreButton, AppRating, .prose) read these. */
    --bg: var(--paper);
    --bg-raised: #FFFFFF;
    --fg: var(--ink);
    --fg-soft: var(--ink-2);
    --fg-mute: var(--ink-3);
    --rule: var(--line-2);
    --accent: var(--h-blue-text);

    background: var(--paper);
    color: var(--ink);
    overflow-x: clip;
  }

  .home .h-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .home h1, .home .h-h2, .home h3 { font-family: var(--serif); font-weight: 500; }
  .home h1 { font-size: clamp(44px, 5.4vw, 76px); line-height: 1.02; letter-spacing: -.025em; margin: 0; text-wrap: balance; }
  .home .h-h2 { font-size: clamp(34px, 4.4vw, 56px); line-height: 1.08; letter-spacing: -.02em; margin: 0; max-width: 18ch; text-wrap: balance; }
  .home .h-kicker { margin: 0 0 16px; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  .home .h-lede { margin: 0; max-width: 32em; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; color: var(--ink-2); }
  .home .h-body { margin: 20px 0 0; max-width: 34em; font-size: 18px; line-height: 1.6; color: var(--ink-2); }
