---
import Layout from '../layouts/Layout.astro';
import AppStoreButton from '../components/AppStoreButton.astro';
import AppRating from '../components/AppRating.astro';
import QRCode from 'qrcode';
import { getAppRating } from '../lib/app-store';
import { SITE, APP_STORE_URL, APP_STORE_ID } from '../consts';
import { FEATURED } from '../data/archive';
import minis from '../data/web-minis.json';

// Read once at build time; null when Apple is unreachable or has no ratings yet.
const rating = await getAppRating(APP_STORE_ID);

// What the app's library says ("246 crosswords"), rounded down so the copy
// never has to change when a puzzle is added.
const LIBRARY = 'more than 200';

const title = 'Bible Crossword Challenge: a daily Bible crossword for iPhone';
const description =
  "Play today's Bible crossword mini right here, free. A fresh puzzle every day with clues from Scripture, a streak that grows, and every puzzle ends on a verse. Free on iOS.";

// Desktop visitors can't install an iPhone app from the page they're on, so
// the two install moments carry a QR code. Each gets its own campaign token.
const qr = (ct: string) =>
  QRCode.toString(`${APP_STORE_URL}?ct=${ct}`, { type: 'svg', margin: 0, errorCorrectionLevel: 'M', color: { dark: '#1D1D1F', light: '#0000' } });
const qrPlay = await qr('web-play-qr');
const qrClose = await qr('web-qr');

// Fresh app captures (2026-11-07, current build). New filenames because
// /assets is immutable at the edge: never overwrite a shot in place.
const story = [
  {
    img: 'shot-v2-today',
    n: '01',
    h: 'Begin with a verse.',
    p: "Today opens on the verse of the day, then today's puzzle and a two-minute Mini. One calm screen, nothing to dig through.",
    alt: "The Today screen: the verse of the day, today's puzzle Parables of the Kingdom with a Start Puzzle button, the Mini, and a 12-day streak",
  },
  {
    img: 'shot-v2-solve',
    n: '02',
    h: 'Solve clues from Scripture.',
    p: 'Every clue comes from the Bible, like “Of the shadow of death” (6). Stuck? A hint checks or reveals a letter without spoiling the rest.',
    alt: 'The Shepherd’s Psalm mini part-solved, with PSALM filled in and the clue “Of the shadow of death” selected',
  },
  {
    img: 'shot-v2-complete',
    n: '03',
    h: 'Finish on the verse.',
    p: 'Each puzzle ends on the passage behind it, with your time and a streak that grows every day you play. Read the chapter, or practise the verse from memory.',
    alt: 'The solved screen: 1:33, a 12-day streak, and Psalm 23:1, “The LORD is my shepherd; I shall not want.”',
  },
  {
    img: 'shot-v2-puzzles',
    n: '04',
    h: 'Walk through the whole story.',
    p: `Journeys take you through Genesis, the life of David and the Gospels, one puzzle at a time, with ${LIBRARY} crosswords in the library.`,
    alt: 'The Puzzles tab: journeys through Genesis, 1 Samuel, Mark and Matthew, then Old Testament packs',
  },
];

// The feature list is written as crossword entries, because that is how this
// product talks. The answers double as the tiles that fill in on scroll.
const features = {
  across: [
    { n: '2A', answer: 'DAILY', enum: '(5)', text: 'A new hand-made puzzle waiting every morning' },
    { n: '4A', answer: 'STREAK', enum: '(6)', text: 'Played today, and yesterday, and the day before' },
    { n: '6A', answer: 'VERSE', enum: '(5)', text: 'What every finished puzzle ends on, chapter and all' },
  ],
  down: [
    { n: '1D', answer: 'HINTS', enum: '(5)', text: 'Fair nudges that unstick you without spoiling it' },
    { n: '3D', answer: 'JOURNEY', enum: '(7)', text: 'From Eden to the empty tomb, one puzzle at a time' },
    { n: '5D', answer: 'OFFLINE', enum: '(7)', text: 'Works on a plane, in the pew, or anywhere else' },
  ],
};

// A tiny crossword glyph per theme card, like the marks on the app's shelf
// covers. Deterministic from the name so it never changes between builds.
function glyph(seed: string) {
  let h = 2166136261;
  for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
  const cells: string[] = [];
  for (let r = 0; r < 5; r++)
    for (let c = 0; c < 5; c++) {
      h = Math.imul(h ^ (r * 5 + c), 16777619);
      if (((h >>> 0) % 100) < 46 || (r === 2 && c > 0 && c < 4)) cells.push(`<rect x="${c * 5}" y="${r * 5}" width="4" height="4" rx="1"/>`);
    }
  return `<svg viewBox="0 0 24 24" aria-hidden="true">${cells.join('')}</svg>`;
}
const decode = (s: string) => s.replace(/&ndash;/g, '–').replace(/&rsquo;/g, '’');
const shelf = FEATURED.map((f) => ({ ...f, eyebrow: decode(f.eyebrow), glyph: glyph(f.name) }));

const faqs = [
  { q: 'Is Bible Crossword Challenge free?', a: 'Yes. Download it and play the daily puzzle and the daily Mini for free. Premium unlocks the full library, every journey and extra hints.' },
  { q: 'Can I play a Bible crossword online?', a: "Yes. Today's Mini is at the top of this page, free, with no sign-up. A new one appears every day. For the full daily puzzle, your streak and the whole library, get the app." },
  { q: 'Is there a new Bible crossword puzzle every day?', a: `Yes. A fresh daily puzzle and a two-minute Mini arrive at midnight, and the library holds ${LIBRARY} hand-made crosswords across the whole Bible, from Noah's Ark to Easter morning.` },
  { q: 'How difficult are the puzzles?', a: 'They are made for everyone, lifelong believers and casual solvers alike. If a clue has you stuck, hints check or reveal a letter without giving the whole answer away.' },
  { q: 'Which Bible translation do the verses use?', a: 'Verses come from the Berean Standard Bible (BSB), a modern, readable translation. Some clues borrow the familiar King James wording.' },
  { q: 'Do I need an account?', a: 'No. The app works fully offline and your progress is saved on your device, and synced privately through iCloud if you play on more than one.' },
  { q: 'Does it work on iPad?', a: 'Yes. Bible Crossword Challenge runs on iPhone and iPad, and your progress syncs between them through iCloud.' },
  { q: 'Is there an Android version?', a: "Bible Crossword Challenge is on iOS today. If you'd like it on Android, tell us. It genuinely helps us decide." },
];

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': ['SoftwareApplication', 'MobileApplication'],
  '@id': `${SITE}/#app`,
  name: 'Bible Crossword Challenge',
  alternateName: 'Bible Crossword',
  url: `${SITE}/`,
  installUrl: APP_STORE_URL,
  downloadUrl: APP_STORE_URL,
  operatingSystem: 'iOS 18.0 or later',
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Word',
  isAccessibleForFree: true,
  inLanguage: 'en',
  author: { '@type': 'Person', name: 'Sambulo Senda' },
  publisher: { '@id': `${SITE}/#publisher` },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    url: APP_STORE_URL,
    availability: 'https://schema.org/InStock',
    category: 'Free download with optional in-app purchase',
  },
  featureList: [
    'A new hand-made Bible crossword and a two-minute Mini every day at midnight',
    `A library of ${LIBRARY} themed crosswords, from Genesis to Revelation`,
    'Journeys through Genesis, the life of David and the Gospels',
    'Every puzzle closes on the verse behind its theme (Berean Standard Bible)',
    'Hints that check or reveal a letter',
    'Daily streaks, achievements and memory-verse practice',
    'Works fully offline; progress syncs privately through iCloud',
    'No ads and no account required',
  ],
  screenshot: story.map((s) => ({ '@type': 'ImageObject', url: `${SITE}/assets/${s.img}.png`, caption: s.alt })),
  // Only ever emitted alongside the rating the page itself displays.
  ...(rating
    ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: rating.value, ratingCount: rating.count, bestRating: 5, worstRating: 1 } }
    : {}),
  description: 'A fresh Bible crossword every day. Solve Scripture-themed puzzles, build a daily streak, and learn the Word as you play.',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${SITE}/#faq`,
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const verseWords = 'I have hidden Your word in my heart that I might not sin against You.'.split(' ');
---
<Layout title={title} description={description} path="/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(softwareLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <main id="main" class="home">
    <!-- ════ 1. HERO: today's Mini, playable ══════════════════════════════ -->
    <section class="hero" aria-labelledby="hero-h">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="eyebrow rise">A daily Bible crossword for iPhone</p>
          <h1 id="hero-h" class="rise d1">Know the Word, one&nbsp;square at a&nbsp;time.</h1>
          <p class="lede rise d2">
            A fresh crossword every morning, with clues from Scripture and a verse at the end. Try
            today's Mini right here. It takes about two minutes.
          </p>
          <div class="hero-cta rise d3">
            <AppStoreButton ct="web-home" />
            <AppRating rating={rating} />
          </div>
        </div>

        <div class="play rise d2" id="play" data-state="playing">
          <div class="play-card">
            <div class="play-face play-game" id="play-game">
              <header class="play-head">
                <div>
                  <p class="play-kicker" id="play-kicker">Today’s Mini</p>
                  <p class="play-title" id="play-title">&nbsp;</p>
                </div>
                <div class="play-tools">
                  <button type="button" class="tool" id="play-hint" aria-label="Reveal this letter" title="Reveal this letter">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2l.1.7h4.8l.1-.7c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3z"/></svg>
                  </button>
                  <span class="play-time" id="play-time" aria-live="off">0:00</span>
                </div>
              </header>

              <div class="board" id="board" role="grid" aria-label="Crossword grid"></div>

              <div class="cluebar">
                <button type="button" class="cb-nav" id="cb-prev" aria-label="Previous clue">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
                </button>
                <div class="cb-body" id="cb-body">
                  <span class="cb-num" id="cb-num">&nbsp;</span>
                  <span class="cb-text" id="cb-text" aria-live="polite">&nbsp;</span>
                </div>
                <button type="button" class="cb-nav" id="cb-next" aria-label="Next clue">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
              <input class="play-input" id="play-input" type="text" autocomplete="off" autocorrect="off"
                autocapitalize="characters" spellcheck="false" enterkeyhint="next" aria-label="Type a letter" />
              <noscript><p class="cb-text">Turn on JavaScript to play today’s Mini, or get the app.</p></noscript>
            </div>

            <div class="play-face play-done" id="play-done" aria-live="polite" hidden>
              <p class="done-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>Solved</p>
              <p class="done-time" id="done-time">0:00</p>
              <p class="done-meta" id="done-meta">&nbsp;</p>
              <blockquote class="done-verse" id="done-verse">&nbsp;</blockquote>
              <p class="done-ref" id="done-ref">&nbsp;</p>
              <div class="done-next">
                <p class="done-lead">Tomorrow’s puzzle is waiting in the app. Keep the streak going.</p>
                <div class="done-cta">
                  <AppStoreButton ct="web-play" note={false} />
                  <div class="qr-mini" aria-hidden="true">
                    <div class="qr" set:html={qrPlay} />
                    <span>Scan with your<br />iPhone camera</span>
                  </div>
                </div>
                <div class="done-links">
                  <button type="button" class="linkish" id="done-share">Share my time</button>
                  <button type="button" class="linkish" id="done-back">See the grid</button>
                </div>
              </div>
            </div>
          </div>
          <p class="play-foot">A new Mini every day. Free, no sign-up.</p>
        </div>
      </div>
    </section>

    <!-- ════ 2. A MORNING WITH THE WORD: sticky phone story ═══════════════ -->
    <section class="band band-gray story" aria-labelledby="story-h">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">Inside the app</p>
          <h2 id="story-h">A quiet five minutes with the Word.</h2>
          <p class="sec-sub">No ads, no clutter, no pressure. A grid, a verse, and a habit that keeps.</p>
        </div>

        <div class="story-grid">
          <ol class="steps">
            {story.map((s, i) => (
              <li class="step" data-i={i}>
                <span class="step-n">{s.n}</span>
                <h3>{s.h}</h3>
                <p>{s.p}</p>
                <div class="phone phone-inline">
                  <img src={`/assets/${s.img}.webp`} alt={s.alt} width="660" height="1434" loading="lazy" decoding="async" />
                </div>
              </li>
            ))}
          </ol>
          <div class="story-stage" aria-hidden="true">
            <div class="stage-inner">
            <div class="phone phone-sticky">
              <div class="screen">
                {story.map((s, i) => (
                  <img class:list={['stage-img', i === 0 && 'on']} data-i={i} src={`/assets/${s.img}.webp`} alt="" width="660" height="1434" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
                ))}
              </div>
            </div>
            <div class="stage-dots">
              {story.map((_, i) => <span class:list={['dot', i === 0 && 'on']} data-i={i} />)}
            </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════ 3. VERSE: reveals word by word with scroll ═══════════════════ -->
    <section class="band band-ink verse" id="verse" aria-label="Psalm 119:11">
      <div class="wrap">
        <blockquote class="verse-q" id="verse-q">
          {verseWords.map((w) => <span class="w">{w} </span>)}
        </blockquote>
        <cite class="verse-cite">Psalm 119:11</cite>
        <p class="verse-note">
          Every puzzle closes on the verse behind its theme, so each day’s play leaves a little more
          Scripture with you.
        </p>
      </div>
    </section>

    <!-- ════ 4. FEATURES AS A CLUE LIST ═══════════════════════════════════ -->
    <section class="band band-paper" id="features" aria-labelledby="features-h">
      <div class="wrap">
        <div class="sec-head reveal">
          <p class="eyebrow">What’s inside</p>
          <h2 id="features-h">Everything, in so many words.</h2>
          <p class="sec-sub">The features, written the only way a crossword app should write them.</p>
        </div>

        <div class="clues">
          <div class="clue-col reveal">
            <h3>Across</h3>
            {features.across.map((c) => (
              <div class="clue" data-answer={c.answer}>
                <div class="clue-q"><span class="clue-n">{c.n}</span><span class="clue-text">{c.text} <span class="enum">{c.enum}</span></span></div>
                <div class="tiles" role="img" aria-label={`Answer: ${c.answer.toLowerCase()}`}></div>
              </div>
            ))}
          </div>
          <div class="clue-col reveal" data-delay="120">
            <h3>Down</h3>
            {features.down.map((c) => (
              <div class="clue" data-answer={c.answer}>
                <div class="clue-q"><span class="clue-n">{c.n}</span><span class="clue-text">{c.text} <span class="enum">{c.enum}</span></span></div>
                <div class="tiles" role="img" aria-label={`Answer: ${c.answer.toLowerCase()}`}></div>
              </div>
            ))}
          </div>
          <p class="clues-foot reveal">
            <strong>Also in the box:</strong> memory-verse practice, achievements from Bible Beginner
            to Apostle, iCloud sync across your devices, light and dark mode, and not a single ad
            between you and the Word.
          </p>
        </div>
      </div>
    </section>

    <!-- ════ 5. THE SHELF: theme pages ════════════════════════════════════ -->
    <section class="band band-gray" id="about" aria-labelledby="shelf-h">
      <div class="wrap">
        <div class="shelf-head reveal">
          <div>
            <p class="eyebrow">Start anywhere in the story</p>
            <h2 id="shelf-h">From Eden to the empty tomb.</h2>
          </div>
          <a class="more" href="/puzzles/">All puzzles <span aria-hidden="true">›</span></a>
        </div>
      </div>
      <div class="shelf-scroll reveal">
        <ul class="shelf">
          {shelf.map((f) => (
            <li>
              <a class="cover" href={f.href}>
                <span class="cover-glyph" set:html={f.glyph} />
                <span class="cover-name">{f.name}</span>
                <span class="cover-ref">{f.eyebrow}</span>
                <span class="cover-sub">{f.sub.replace(' · Bible crossword', '')}</span>
              </a>
            </li>
          ))}
          <li>
            <a class="cover cover-all" href="/puzzles/printable/">
              <span class="cover-glyph" set:html={glyph('printables')} />
              <span class="cover-name">Printables</span>
              <span class="cover-ref">For Sunday school and small groups</span>
              <span class="cover-sub">Free PDFs</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="wrap">
        <div class="prose shelf-prose reveal">
          <p>
            Bible Crossword Challenge is a Christian word game built around one simple habit: a daily
            Bible crossword you can finish with your morning coffee. Every clue is rooted in
            Scripture, the people, places, miracles and verses of the Bible, so each grid you solve
            leaves a little more of the Word with you. Beyond the daily puzzle, the
            <a href="/puzzles/">library of Bible crosswords</a> covers the whole story:
            <a href="/puzzles/noahs-ark/">Noah's Ark</a>,
            <a href="/puzzles/david-and-goliath/">David and Goliath</a>, the Exodus, the Parables,
            <a href="/puzzles/christmas/">the Christmas story</a> and
            <a href="/puzzles/easter/">Easter and the Resurrection</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- ════ 6. FAQ ════════════════════════════════════════════════════════ -->
    <section class="band band-paper" id="faq" aria-labelledby="faq-h">
      <div class="wrap faq-grid">
        <div class="reveal">
          <p class="eyebrow">Questions</p>
          <h2 id="faq-h">Before you ask.</h2>
        </div>
        <div class="faq reveal" data-delay="120">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ════ 7. CLOSE ══════════════════════════════════════════════════════ -->
    <section class="band band-ink final" id="get" aria-labelledby="final-h">
      <div class="grid-field" aria-hidden="true"></div>
      <div class="wrap final-inner reveal">
        <p class="eyebrow">Tomorrow’s puzzle arrives at midnight</p>
        <h2 id="final-h">Start your streak today.</h2>
        <p class="sec-sub">Free on the App Store, for iPhone and iPad.</p>
        <div class="final-cta">
          <AppStoreButton ct="web-close" note={false} />
          <div class="qr-mini qr-dark" aria-hidden="true">
            <div class="qr" set:html={qrClose} />
            <span>Or scan with<br />your iPhone</span>
          </div>
        </div>
        <AppRating rating={rating} center />
      </div>
    </section>
  </main>

  <script type="application/json" id="minis-data" set:html={JSON.stringify(minis)} />
</Layout>

<style is:global>
  /* Home-page composition. Global (not scoped) because the board, tiles and
     verse words are built or toggled in JS. Every rule is under .home so it
     can't reach other pages, and none restyles a global.css selector at equal
     specificity (see the cascade note in global.css's neighbours). */

  .home {
    --serif: ui-serif, "New York", "Iowan Old Style", Charter, Georgia, serif;
    --sys-bg: #F2F2F7;          /* iOS systemGroupedBackground, as in the app */
    --block: #E3E3E8;           /* the app's soft-grey block squares */
    --cursor: #B9D6FA;
    --wrong: #D70015;
  }
  .home .sec-head { text-align: center; }
  .home .sec-head .sec-sub { margin-inline: auto; }

  /* ── 1. hero ──────────────────────────────────────────────────────────── */
  .home .hero { padding: clamp(40px, 6vw, 88px) 0 clamp(64px, 8vw, 112px); overflow: hidden; }
  .home .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, .98fr);
    gap: clamp(32px, 5vw, 80px); align-items: center;
  }
  .home .hero-copy h1 { max-width: 11.5ch; margin-bottom: var(--s-3); font-size: clamp(38px, 5.2vw, 76px); line-height: 1.02; letter-spacing: -.03em; text-wrap: balance; }
  .home .hero-copy .lede { margin: 0 0 var(--s-4); max-width: 30ch; }
  .home .hero-cta .app-rating { margin-top: var(--s-2); }

  /* ── the playable card ────────────────────────────────────────────────── */
  .home .play { width: 100%; max-width: 480px; justify-self: end; }
  .home .play-card {
    position: relative;
    background: var(--sys-bg);
    border-radius: 36px;
    padding: clamp(16px, 2.4vw, 24px);
    box-shadow: 0 1px 0 rgba(0,0,0,.02), 0 30px 80px -40px rgba(0, 0, 0, .28);
  }
  .home .play-face[hidden] { display: none; }
  .home .play-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin: 2px 4px 16px; }
  .home .play-kicker { margin: 0; font-size: 13px; font-weight: 600; color: var(--fg-mute); letter-spacing: -.005em; }
  .home .play-title { margin: 2px 0 0; font-size: 21px; font-weight: 600; letter-spacing: -.02em; line-height: 1.2; }
  .home .play-tools { display: flex; align-items: center; gap: 6px; }
  .home .play-time { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 17px; min-width: 3.2em; text-align: right; color: var(--fg); }
  .home .tool {
    width: 36px; height: 36px; border-radius: 50%; border: 0; background: transparent; cursor: pointer;
    display: grid; place-items: center; color: var(--blue); transition: background .15s ease;
  }
  .home .tool:hover { background: rgba(0, 113, 227, .08); }
  .home .tool svg, .home .cb-nav svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }

  .home .board {
    --cols: 7; --rows: 7;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: clamp(3px, .6vw, 5px);
    aspect-ratio: var(--cols) / var(--rows);
    touch-action: manipulation;
    user-select: none; -webkit-user-select: none;
  }
  .home .sq {
    position: relative; border-radius: clamp(6px, 1vw, 9px);
    /* Faint, so the shape of the words reads first, not a grey wall. */
    background: color-mix(in srgb, var(--block) 40%, transparent);
  }
  .home .sq.open {
    background: #fff; cursor: pointer;
    box-shadow: 0 1px 1.5px rgba(0, 0, 0, .07);
    display: grid; place-items: center;
    font-size: clamp(20px, 3.2vw, 30px); font-weight: 500; color: var(--near-black);
    transition: background .18s ease, box-shadow .18s ease;
  }
  .home .sq.word { background: var(--blue-wash); }
