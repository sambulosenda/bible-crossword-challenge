---
import Layout from '../../layouts/Layout.astro';
import Brand from '../../components/Brand.astro';
import { APP_STORE_URL } from '../../consts';

// One page, two payloads. Both arrive on this path because the app's
// apple-app-site-association file claims `/challenge*` and nothing else, so a
// separate `/board/` route would open Safari instead of the app. They're told
// apart by the query: `e=` entries mean a family board, `t`/`n` mean a
// one-to-one challenge. See Services/FamilyBoardService.swift.
//
// The page is static, so the copy below is what shows in a link preview for
// *either* kind — it has to read true for both. The DOM does the specialising.
const title = 'A Bible Crossword Challenge for you';
const description =
  'Someone sent you a Bible crossword. Beat their time on iOS — free on the App Store.';
---
<Layout title={title} description={description} path="/challenge/" robots="noindex, follow" chrome={false}>
  <main id="main" class="challenge-wrap">
    <article class="challenge-card">
      <div class="challenge-mark"><Brand size={44} /></div>

      <div id="solo">
        <p class="eyebrow" style="justify-content:center">You've been challenged</p>
        <h1><span id="name">A friend</span> beat this puzzle</h1>
        <p class="challenge-time" id="time" hidden>Their time: <b id="timeval"></b></p>
      </div>

      <div id="board" hidden>
        <p class="eyebrow" style="justify-content:center">Family board</p>
        <h1>Can you beat this lot?</h1>
        <p class="challenge-time" id="boardcount"></p>
        <ol class="board-list" id="boardlist"></ol>
      </div>

      <p class="lede" id="lede" style="margin:0 auto 28px; text-align:center">
        Think you can go faster? Get Bible Crossword Challenge — a fresh Scripture crossword every day — and prove it.
      </p>
      <a class="btn-store" href={APP_STORE_URL} id="cta" rel="noopener">
        <span><small>Download on the</small><strong>App Store</strong></span>
      </a>
      <p class="challenge-note" id="reopen" hidden></p>
      <p class="challenge-foot"><a href="/">biblecrosswordchallenge.com</a></p>
    </article>
  </main>
</Layout>

<style is:global>
  .challenge-wrap { min-height: 100vh; display: grid; place-items: center; padding: 28px; }
  .challenge-card {
    width: 100%; max-width: 440px; text-align: center;
    border: 1px solid var(--rule); border-radius: 22px; background: var(--bg-raised);
    padding: 40px 30px 30px; box-shadow: var(--shadow-lift);
  }
  .challenge-mark { display: flex; justify-content: center; margin-bottom: 20px; }
  .challenge-mark .brand-name { display: none; }
  .challenge-card h1 { font-size: clamp(28px, 7vw, 40px); text-align: center; }
  .challenge-card .btn-store { justify-content: center; }
  .challenge-time {
    font-family: var(--mono); font-size: 15px; color: var(--fg-soft);
    background: var(--bg-sunk); border-radius: 999px; padding: 8px 16px;
    display: inline-block; margin: 4px 0 24px;
  }
  [hidden] { display: none !important; }
  .challenge-time b { color: var(--ink); font-weight: 600; }
  .challenge-note { font-size: 14px; color: var(--fg-mute); margin: 24px auto 0; max-width: 36ch; }
  .challenge-foot { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-mute); margin-top: 26px; }
  .challenge-foot a:hover { color: var(--fg); }

  /* Ranked standings. Mirrors the board card in the app: rank, name, time. */
  .board-list { list-style: none; margin: 0 0 28px; padding: 0; text-align: left; }
  .board-list li {
    display: flex; align-items: baseline; gap: 12px;
    padding: 10px 14px; border-radius: 12px;
  }
  .board-list li + li { margin-top: 2px; }
  .board-list li:nth-child(odd) { background: var(--bg-sunk); }
  .board-rank {
    font-family: var(--mono); font-size: 13px; color: var(--fg-mute);
    min-width: 1.6em; text-align: right; flex: none;
  }
  .board-name {
    flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .board-secs { font-family: var(--mono); font-weight: 600; color: var(--fg); flex: none; }
</style>

<script>
  const q = new URLSearchParams(location.search);

  /** m:ss, or h:mm:ss past an hour — matches TimeFormat.clock in the app. */
  function clock(total: number): string {
    const h = Math.floor(total / 3600);
    const m = Math.floor((total % 3600) / 60);
    const s = total % 60;
    const ss = (s < 10 ? '0' : '') + s;
    if (h > 0) return h + ':' + (m < 10 ? '0' : '') + m + ':' + ss;
    return m + ':' + ss;
  }

  const MAX_NAME = 20;
  const MAX_SECONDS = 86400;
  const MAX_STANDINGS = 12;

  /**
   * `"154:Sam"` — seconds first so a name may contain anything after the first
   * colon, colons included. Same rule as FamilyBoardService.parseStanding.
   */
  function parseStanding(raw: string): { name: string; seconds: number } | null {
    const cut = raw.indexOf(':');
    if (cut < 0) return null;
    const seconds = parseInt(raw.slice(0, cut), 10);
    if (isNaN(seconds) || seconds < 1 || seconds > MAX_SECONDS) return null;
    const name = raw.slice(cut + 1).trim().slice(0, MAX_NAME);
    if (!name) return null;
    return { name, seconds };
  }

  const standings = q
    .getAll('e')
    .map(parseStanding)
    .filter((s): s is { name: string; seconds: number } => s !== null)
    // Fastest first, then alphabetically, exactly as the app ranks them.
    .sort((a, b) => (a.seconds === b.seconds ? a.name.localeCompare(b.name) : a.seconds - b.seconds))
    .slice(0, MAX_STANDINGS);

  const lede = document.getElementById('lede')!;
  const reopen = document.getElementById('reopen')!;
  let who = 'your friend';

  if (standings.length > 0) {
    document.getElementById('solo')!.hidden = true;
    document.getElementById('board')!.hidden = false;

    const count = document.getElementById('boardcount')!;
    count.textContent =
      standings.length + (standings.length === 1 ? ' player so far' : ' players so far');

    const list = document.getElementById('boardlist')!;
    standings.forEach((standing, index) => {
      const row = document.createElement('li');

      const rank = document.createElement('span');
      rank.className = 'board-rank';
      rank.textContent = ['🥇', '🥈', '🥉'][index] ?? String(index + 1);

      const name = document.createElement('span');
      name.className = 'board-name';
      // textContent, never innerHTML: these names came off a URL a stranger
      // could have written.
      name.textContent = standing.name;

      const secs = document.createElement('span');
      secs.className = 'board-secs';
      secs.textContent = clock(standing.seconds);

      row.append(rank, name, secs);
      list.append(row);
    });

    lede.textContent =
      'They all played the same puzzle. Get Bible Crossword Challenge — a fresh Scripture crossword every day — play it, and add your time to the board.';
    who = standings[0].name;
    reopen.textContent =
      'Already have the app? Ask whoever sent this to share the link again — it\'ll open the board.';
  } else {
    const rawName = (q.get('n') || '').trim().slice(0, MAX_NAME);
    if (rawName) document.getElementById('name')!.textContent = rawName;
    const secs = parseInt(q.get('t') || '', 10);
    if (!isNaN(secs) && secs > 0 && secs < MAX_SECONDS) {
      document.getElementById('timeval')!.textContent = clock(secs);
      document.getElementById('time')!.hidden = false;
    }
    who = rawName || 'your friend';
    reopen.textContent =
      'Already have the app? Ask ' + who + " to send the link again — it'll open your challenge.";
  }

  reopen.hidden = false;
</script>
