---
// The app-icon mark + wordmark, used in the nav, footer, and the standalone
// /challenge and /go cards. This is the *actual* App Store icon, not a
// stand-in: every one of these surfaces is a step towards the store, and the
// handoff only reads as one product if the mark someone taps matches the icon
// they land on.
//
// The source PNG is full-bleed square (iOS masks its own corners), so the
// rounding is applied here. 22.4% approximates Apple's superellipse and, being
// proportional, holds at every `size` the callers pass — 30 in the nav and
// footer, 44 on /challenge, 56 on /go.
//
// No ink-band treatment: the icon is bright blue on every band, so unlike the
// old dark mark it needs no hairline ring to keep its silhouette.
interface Props { size?: number; }
const { size = 30 } = Astro.props;
---
<a class="brand" href="/" aria-label="Bible Crossword Challenge home">
  <img
    class="brand-mark"
    src="/assets/icon-192.png"
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    decoding="async"
  />
  <span class="brand-name">Bible Crossword Challenge</span>
</a>
