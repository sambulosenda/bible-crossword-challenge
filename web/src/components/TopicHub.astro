---
// Shared layout for the topic hub pages (/puzzles/old-testament/ etc.).
// Membership comes from topics.ts matchers over the theme-page collection,
// so each hub stays current as theme pages are added.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import AppStoreButton from './AppStoreButton.astro';
import { SITE } from '../consts';
import { TOPICS, difficultyOf, type Topic } from '../data/topics';

interface Props {
  topic: Topic;
}
const { topic } = Astro.props;

const plain = (s: string) =>
  s.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&mdash;/g, '—').replace(/&rsquo;/g, '’').trim();

const all = await getCollection('puzzles');
const themes = all
  .map((entry) => ({
    slug: entry.id,
    href: `/puzzles/${entry.id}/`,
    heading: entry.data.heading,
    reference: entry.data.reference,
    difficulty: difficultyOf(entry.data.meta),
  }))
  .filter((t) => topic.match(t))
  .sort((a, b) => plain(a.heading).localeCompare(plain(b.heading)));

if (themes.length === 0) {
  throw new Error(`Topic hub ${topic.path} matched no theme pages — check its matcher in topics.ts.`);
}

const others = TOPICS.filter((t) => t.slug !== topic.slug);

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Puzzles', item: `${SITE}/puzzles/` },
    { '@type': 'ListItem', position: 3, name: topic.name, item: `${SITE}${topic.path}` },
  ],
};

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: plain(topic.h1),
  url: `${SITE}${topic.path}`,
  description: topic.description,
  isPartOf: { '@type': 'WebSite', name: 'Bible Crossword Challenge', url: `${SITE}/` },
  mainEntity: {
    '@type': 'ItemList',
    name: plain(topic.h1),
    numberOfItems: themes.length,
    itemListElement: themes.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Game',
        name: `${plain(t.heading)} — Bible crossword`,
        genre: 'Crossword',
        url: `${SITE}${t.href}`,
      },
    })),
  },
};
---
<Layout title={topic.title} description={topic.description} path={topic.path}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
  </Fragment>

  <main id="main" class="page">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span>/</span><a href="/puzzles/">Puzzles</a><span>/</span>{topic.name}</p>
      <p class="eyebrow">{topic.eyebrow}</p>
      <h1 set:html={topic.h1} />
      <p class="meta-chips"><b>{themes.length}</b> themed puzzles · free printable PDF on every page</p>
      <div class="prose">
        {topic.intro.map((para) => <p set:html={para} />)}
      </div>

      <div class="content-section">
        <div class="theme-grid">
          {themes.map((t) => (
            <a class="theme-card" href={t.href}>
              <span class="t-eyebrow" set:html={t.reference} />
              <span class="t-name" set:html={t.heading} />
              <span class="t-sub">{t.difficulty} · Bible crossword</span>
            </a>
          ))}
        </div>

        <h2>More ways to browse</h2>
        <div class="prose">
          <p>
            {others.map((t, i) => (
              <Fragment>
                <a href={t.path}>{t.name} puzzles</a>{i < others.length - 1 ? ' · ' : ' · '}
              </Fragment>
            ))}
            <a href="/puzzles/printable/">Printable PDFs</a> · <a href="/puzzles/">the full archive</a>
          </p>
        </div>

        <div style="margin-top:34px"><AppStoreButton /></div>
      </div>
    </div>
  </main>
</Layout>
