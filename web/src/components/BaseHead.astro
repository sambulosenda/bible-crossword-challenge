---
import { SITE, APP_STORE_ID, APP_STORE_URL } from '../consts';
interface Props {
  title: string;
  description: string;
  /** Absolute path for the canonical URL, e.g. "/how-to-play/". */
  path?: string;
  robots?: string;
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description,
  path = new URL(Astro.request.url).pathname,
  robots = 'index, follow',
  ogImage = `${SITE}/assets/og-image.png`,
  ogImageAlt = 'Bible Crossword Challenge — a daily Bible crossword for iPhone and iPad',
} = Astro.props;
const canonical = new URL(path, SITE).href;

// One publisher/site entity carried on every page, so search and answer engines
// resolve the whole domain to a single thing rather than a set of loose pages.
const entityLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#publisher`,
      name: 'Bible Crossword Challenge',
      url: `${SITE}/`,
      logo: { '@type': 'ImageObject', url: `${SITE}/assets/icon-180.png`, width: 180, height: 180 },
      founder: { '@type': 'Person', name: 'Sambulo Senda' },
      sameAs: [APP_STORE_URL],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Bible Crossword Challenge',
      url: `${SITE}/`,
      description:
        'A daily Bible crossword for iPhone and iPad, with clues rooted in the King James Version.',
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#publisher` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE}/#website` },
      inLanguage: 'en',
    },
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#0D1017" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F7F4EC" media="(prefers-color-scheme: light)" />
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content="Bible Crossword Challenge" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- The real App Store icon, not a stand-in — the tab, the home-screen bookmark
     and the store listing should all be recognisably the same object. It costs
     one small cached request where the old inline SVG cost none; worth it.

     Size in the filename, never overwritten: /assets/* is served immutable for
     a year (public/_headers), so a changed icon MUST arrive at a new path or
     the edge and every returning browser keep the old bytes. -->
<link rel="icon" type="image/png" sizes="48x48" href="/assets/icon-48.png" />
<link rel="apple-touch-icon" href="/assets/icon-180.png" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<!-- Fraunces carries the display voice, Newsreader sets scripture and long
     copy. Both are self-hosted (see the @font-face block at the top of
     global.css), which removes the DNS lookup and TLS handshake to
     fonts.gstatic.com that used to stand between a visitor and the first
     painted heading — and with it the render-blocking third-party stylesheet
     the old `media=print` trick existed to work around.

     Only the two latin roman faces are preloaded: they set the h1 and the body
     copy on every page, and without a preload the browser cannot discover them
     until it has parsed the CSS. The italic and latin-ext faces are left to be
     fetched on demand — they are rarer, and preloading everything would put
     ~350KB in front of the page instead of ~200KB. `font-display: swap` means
     text paints in Georgia meanwhile either way. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-v38-latin.woff2" crossorigin />
<link rel="preload" as="font" type="font/woff2" href="/fonts/newsreader-v26-latin.woff2" crossorigin />

<script type="application/ld+json" set:html={JSON.stringify(entityLd)} />
