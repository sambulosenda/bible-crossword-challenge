---
import { SITE, APP_STORE_ID, APP_STORE_URL } from '../consts';
interface Props {
  title: string;
  description: string;
  /** Absolute path for the canonical URL, e.g. "/how-to-play/". */
  path?: string;
  robots?: string;
  ogImage?: string;
  ogImageAlt?: string;
}
const {
  title,
  description,
  path = new URL(Astro.request.url).pathname,
  robots = 'index, follow',
  ogImage = `${SITE}/assets/og-image.png`,
  ogImageAlt = 'Bible Crossword Challenge — a daily Bible crossword for iPhone and iPad',
} = Astro.props;
const canonical = new URL(path, SITE).href;

// One publisher/site entity carried on every page, so search and answer engines
// resolve the whole domain to a single thing rather than a set of loose pages.
const entityLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#publisher`,
      name: 'Bible Crossword Challenge',
      url: `${SITE}/`,
      logo: { '@type': 'ImageObject', url: `${SITE}/assets/icon-180.png`, width: 180, height: 180 },
      founder: { '@type': 'Person', name: 'Sambulo Senda' },
      sameAs: [APP_STORE_URL],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Bible Crossword Challenge',
      url: `${SITE}/`,
      description:
        'A daily Bible crossword for iPhone and iPad, with clues rooted in the King James Version.',
      inLanguage: 'en',
      publisher: { '@id': `${SITE}/#publisher` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE}/#website` },
      inLanguage: 'en',
    },
  ],
};
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />
<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
<meta name="apple-itunes-app" content={`app-id=${APP_STORE_ID}`} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content="Bible Crossword Challenge" />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- The real App Store icon, not a stand-in — the tab, the home-screen bookmark
     and the store listing should all be recognisably the same object. It costs
     one small cached request where the old inline SVG cost none; worth it.

     Size in the filename, never overwritten: /assets/* is served immutable for
     a year (public/_headers), so a changed icon MUST arrive at a new path or
     the edge and every returning browser keep the old bytes. -->
<link rel="icon" type="image/png" sizes="48x48" href="/assets/icon-48.png" />
<link rel="apple-touch-icon" href="/assets/icon-180.png" />
<link rel="sitemap" type="application/xml" href="/sitemap.xml" />

<!-- The whole site sets in the system SF stack — no webfonts, so nothing to
     preload. The old self-hosted serif files remain under /fonts (immutable
     path) but are intentionally unreferenced. -->

<script type="application/ld+json" set:html={JSON.stringify(entityLd)} />
