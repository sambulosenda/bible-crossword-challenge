---
import Brand from './Brand.astro';
import { APP_STORE_URL } from '../consts';

interface Props {
  /** True when the page opens on an ink band — the nav then starts as
      transparent chrome and condenses onto paper on scroll. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;
---
<header class="nav" data-mode={overHero ? 'over' : 'stuck'} data-overhero={String(overHero)}>
  <div class="wrap nav-inner">
    <Brand />
    <nav class="nav-links" aria-label="Main">
      <a class="nav-link secondary" href="/puzzles/">Puzzles</a>
      <a class="nav-link secondary" href="/how-to-play/">How to play</a>
      <a class="nav-link primary" href={APP_STORE_URL} rel="noopener">Get the app</a>
    </nav>
  </div>
</header>
