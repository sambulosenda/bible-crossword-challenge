# Cloudflare Pages response headers.

# Apple's App Site Association must be served as JSON, 200, no redirect —
# universal links (biblecrosswordchallenge.com/challenge*) depend on it.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Long-cache immutable static assets (screenshots, icons, og image).
#
# `immutable` means exactly that: never overwrite a file here in place. The edge
# holds it for a year and returning browsers never revalidate, so a replaced
# icon or screenshot keeps serving the old bytes long after the deploy. Ship
# changed art at a NEW path instead — that is why the icons carry their size
# (icon-48/180/192.png) rather than a bare apple-touch-icon.png.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts. Same immutable contract as /assets/*: the filenames carry
# the font version (fraunces-v38-…), so an updated font MUST ship at a new path
# rather than replacing one of these in place.
#
# crossorigin on the <link rel=preload> means the font is fetched in CORS mode
# even though it is same-origin, so the header below has to be present or the
# preloaded file is discarded and fetched a second time.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Astro's own build output is content-hashed (index.CuPGxOBj.css), so a changed
# file gets a changed filename and these can never go stale. Without this rule
# Pages serves them `max-age=0, must-revalidate` and the CSS is re-fetched on
# every visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
