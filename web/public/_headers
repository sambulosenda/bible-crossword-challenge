# Cloudflare Pages response headers.

# Apple's App Site Association must be served as JSON, 200, no redirect —
# universal links (biblecrosswordchallenge.com/challenge*) depend on it.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Long-cache immutable static assets (screenshots, icons, og image).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Astro's own build output is content-hashed (index.CuPGxOBj.css), so a changed
# file gets a changed filename and these can never go stale. Without this rule
# Pages serves them `max-age=0, must-revalidate` and the CSS is re-fetched on
# every visit.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
