# Copy this file to `fastlane/.env` and fill in your values.
# `fastlane/.env` is git-ignored — never commit real keys.
# fastlane loads this automatically on every run (dotenv).

# Terminal text encoding (must be UTF-8 for accented metadata). Any *.UTF-8 works.
LANG=en_US.UTF-8
LC_ALL=en_US.UTF-8

# App Store Connect API key (App Store Connect > Users and Access > Integrations).
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Absolute path to the downloaded .p8 (keep it OUTSIDE the repo).
ASC_KEY_PATH=/Users/you/asc/AuthKey_XXXXXXXXXX.p8
