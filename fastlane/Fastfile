default_platform(:ios)

# Builds an App Store Connect API token from the env vars in fastlane/.env
def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false,
  )
end

platform :ios do
  desc "Push title/subtitle/keywords for all locales. Shows an HTML preview and asks " \
       "for confirmation before uploading. No binary, no screenshots, no submission. " \
       "Pass version:X.Y to create/select that editable version in App Store Connect."
  lane :push_metadata do |options|
    deliver(
      api_key: asc_api_key,
      force: options.fetch(:force, false),
      app_version: options[:version],
    )
  end

  desc "Archive the app and upload the binary to App Store Connect. No metadata, " \
       "no screenshots, no submission — the build lands in ASC for manual selection. " \
       "Signing is cloud-managed through the ASC API key, so no local distribution " \
       "certificate is required."
  lane :upload_build do
    api_key = asc_api_key
    build_app(
      project: "Bible Crossword Challenge.xcodeproj",
      scheme: "Bible Crossword Challenge",
      export_method: "app-store",
      output_directory: "build",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath '#{ENV.fetch("ASC_KEY_PATH")}' " \
              "-authenticationKeyID #{ENV.fetch("ASC_KEY_ID")} " \
              "-authenticationKeyIssuerID #{ENV.fetch("ASC_ISSUER_ID")}",
    )
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Upload App Store screenshots for all locales (no metadata, no binary, no " \
       "submission). Overwrites the existing screenshot set for the editable version."
  lane :upload_screenshots do |options|
    deliver(
      api_key: asc_api_key,
      skip_metadata: true,
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: options.fetch(:force, false),
    )
  end

  desc "Upload an already-built .ipa without re-archiving. Use when upload_build " \
       "produced build/*.ipa but the upload leg failed — saves the ~25 minute archive."
  lane :upload_ipa do |options|
    upload_to_testflight(
      api_key: asc_api_key,
      ipa: options.fetch(:ipa, "build/Bible Crossword Challenge.ipa"),
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Submit an editable version for App Store review: pushes metadata for every " \
       "locale, selects the build, answers export compliance and IDFA, and submits. " \
       "Pass version:X.Y and build:N. Never uploads a binary or screenshots — the " \
       "screenshot set already on the version is left untouched. Add auto_release:true " \
       "to go live the moment Apple approves; the default holds it for a manual " \
       "release. Run upload_build first and let the build finish processing."
  lane :submit do |options|
    deliver(
      api_key: asc_api_key,
      app_version: options.fetch(:version),
      build_number: options[:build]&.to_s,
      submit_for_review: true,
      automatic_release: options.fetch(:auto_release, false),
      force: options.fetch(:force, true),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      run_precheck_before_submit: true,
      precheck_include_in_app_purchases: false,
      submission_information: {
        # No ad network or attribution SDK ships in the app (install attribution
        # is App Store campaign tokens only), and it uses nothing beyond HTTPS
        # and system crypto.
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
      },
    )
  end
end
